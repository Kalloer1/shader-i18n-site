# Change effect names through language instead of the shader itself
# How to change names and comments:
# option.EffectName=New effect name
# option.EffectName.comment=Your comment.
#
# Change screen names through language instead of properties
# How to change screen names and give them comments:
# screen.ScreenName=New screen name
# screen.ScreenName.comment=Your comment
#
# Tooltip lines ending with "!" are automatically shown red.
# example: option.SHADOW_FILTER.comment=Smooth out shadows. Very small performance hit!.


#Options
#############################
option.TAA_sharpness=锐化

option.HandLight=手持光源
option.HandLight.comment=切换手持光照。

option.Celshading=卡通渲染
option.Celshading.comment=为所有物体添加黑色轮廓，营造漫画风格。就像在《无主之地》中一样。

option.skyReflection=天空反射
option.skyReflection.comment=反射并混合默认天空颜色。使水波更明显。开发中

option.Reflections=反射
option.Reflections.comment=为透明方块（如水、染色玻璃和冰）切换反射效果。
option.Refl_Quality=反射质量
option.Refl_Quality.comment=调整反射质量。精细模式会提高光线追踪精度以减少故障，但会牺牲性能。
value.Refl_Quality.1=快速
value.Refl_Quality.2=花哨

option.WaterReflection=水体反射
option.WaterReflection.comment=请参阅 block.properties 添加自定义水ID。
option.TransparentReflections=透明反射
option.TransparentReflections.comment=请参阅 block.properties 调整可反射方块。

option.Depth_of_Field=景深
option.Depth_of_Field.comment=模拟眼睛对焦物体。§4对性能影响低
option.DoF_Strength=景深强度
option.DoF_Strength.comment=调整模糊效果强度。
value.DoF_Strength.60=低
value.DoF_Strength.90=默认
value.DoF_Strength.120=高
value.DoF_Strength.150=极高

option.smoothDof=平滑过渡
option.smoothDof.comment=切换在对焦物体时的清晰与模糊平滑过渡。

option.Distance_Blur=距离模糊
option.Distance_Blur.comment=§4需要启用景深。用距离模糊替代眼睛对焦效果。

option.Dof_Distance_View=模糊视距
option.Dof_Distance_View.comment=调节模糊视距。
value.Dof_Distance_View.128=近距离
value.Dof_Distance_View.256=默认
value.Dof_Distance_View.384=远
value.Dof_Distance_View.512=非常远

option.Motionblur=动态模糊
option.Motionblur.comment=在移动时模糊视野/镜头。与景深效果不兼容。

option.MB_strength=模糊强度
option.MB_strength.comment=调整动态模糊的模糊强度。
value.MB_strength.0.008=低
value.MB_strength.0.014=默认
value.MB_strength.0.020=高

option.sunPathRotation=太阳/月亮角度
option.sunPathRotation.comment=调节太阳和月亮角度。
value.sunPathRotation.-0.15f=默认
value.sunPathRotation.-40.0f=备选方案

option.Godrays=丁达尔光效
option.Godrays.comment=切换体积光。
option.grays_quality=光束质量
option.grays_quality.comment=调整体积光质量：快速模式性能损耗低，精细模式性能损耗高。
value.grays_quality.1=快速
value.grays_quality.2=花哨
option.grays_intensity=体积光强度

option.Colored_Shadows=彩色阴影
option.Colored_Shadows.comment=切换彩色阴影。光线穿过染色玻璃时阴影会着色。

option.grass_shadows=草地阴影
option.grass_shadows.comment=切换草丛阴影。

option.shadowMapResolution=阴影分辨率
option.shadowMapResolution.comment=调整阴影分辨率。
value.shadowMapResolution.512=极低
value.shadowMapResolution.1024=低
value.shadowMapResolution.2048=中
value.shadowMapResolution.3072=高
value.shadowMapResolution.4096=极高
value.shadowMapResolution.8192=极端

option.shadowDistance=阴影视距
option.shadowDistance.comment=调整阴影的可视距离。
value.shadowDistance.60.0=非常近
value.shadowDistance.90.0=近距离
value.shadowDistance.120.0=远
value.shadowDistance.150.0=非常远
value.shadowDistance.180.0=较远
value.shadowDistance.210.0=极远

option.slight=光照强度
option.slight.comment=调整阴影/光照的强度

option.Whiteworld=白色世界
option.Whiteworld.comment=使地面变白，主要用于调试。因大量请求而添加此选项。我猜用于截图看起来还挺酷。

option.waterTex=水面纹理
option.waterTex.comment=切换资源包水面纹理。

option.MobsFlashRed=受伤闪红
option.MobsFlashRed.comment=使生物和玩家在受伤时闪现红色。

option.Colorboost=色彩增强
option.Colorboost.comment=启用后，为默认颜色增添些许活力。

option.Waving_Leaves=摇摆树叶
option.Waving_Leaves.comment=

option.Waving_Vines=摆动藤蔓
option.Waving_Vines.comment=

option.Waving_Grass=摇曳草丛
option.Waving_Grass.comment=

option.Waving_Tallgrass=高草摇曳
option.Waving_Tallgrass.comment=

option.Waving_Fire=摆动火焰
option.Waving_Fire.comment=

option.Waving_Lanterns=摇曳灯笼

option.Waving_Lava=摆动熔岩
option.Waving_Lava.comment=

option.Waving_Water=水波荡漾
option.Waving_Water.comment=包含睡莲摇曳效果。

option.waves_amplitude=波动幅度
option.waves_amplitude.comment=调整摇曳水波的幅度。

option.Waving_Entities=摆动实体
option.Waving_Entities.comment=包括：树苗、小花、小麦、胡萝卜、马铃薯和甜菜根。

option.depthbuffer=深度缓冲
option.depthbuffer.comment=启用后绘制深度缓冲区。

option.draw_refnormals=绘制反射法线

option.draw_bmap=绘制凹凸贴图法线

option.nMap=资源包支持
option.nMap.comment=为资源包启用凹凸或视差支持，资源包需自身支持该功能。
value.nMap.0=关
value.nMap.1=凹凸贴图
value.nMap.2=视差

option.POM_RES=资源包分辨率
option.POM_RES.comment=将分辨率提升超过资源包分辨率会使画面更平滑。
option.POM_DEPTH=POM深度
option.POM_DEPTH.comment=调整视差贴图深度，过高数值可能显得怪异。
option.POM_DIST=视差距离
option.POM_DIST.comment=调整视差贴图的渲染距离。

option.ambientOcclusionLevel=默认我的世界环境光遮蔽
option.ambientOcclusionLevel.comment=我的世界自带环境光遮蔽效果。

option.customLight=自定义光照贴图
option.customLight.comment=切换自定义光照贴图并调整自发光颜色。
option.emissive_R=红
option.emissive_G=绿
option.emissive_B=蓝

option.IRIS_END_FIX=Iris末地修复
option.IRIS_END_FIX.comment=针对Iris 1.21.5+版本亮度过高的末地天空的解决方案。若末地天空过暗请禁用此项。不适用于1.21.5之前的版本。
#----------------------------------------------------

#Screens
screen.AA_SCREEN=抗锯齿
screen.AA_SCREEN.comment=切换时间抗锯齿（TAA）与自适应锐化。

screen.AO_SCREEN=环境光遮蔽
screen.AO_SCREEN.comment=切换屏幕空间环境光遮蔽（SSAO）并调整我的世界默认环境光遮蔽。

screen.COLOR_SCREEN=颜色
screen.COLOR_SCREEN.comment=包含色彩增强与交叉处理（颜色滤镜）

screen.DOF_SCREEN=景深
screen.DOF_SCREEN.comment=调整景深相关设置。

screen.NORMALMAP_SCREEN=法线贴图
screen.NORMALMAP_SCREEN.comment=若资源包支持，则启用凹凸或视差贴图支持。

screen.MOTION_SCREEN=动态模糊
screen.MOTION_SCREEN.comment=调整动态模糊相关设置。

screen.REFLECTIONS_SCREEN=反射
screen.REFLECTIONS_SCREEN.comment=包含反射相关设置。

screen.SHADOWS_SCREEN=阴影
screen.SHADOWS_SCREEN.comment=包含阴影相关设置（如阴影视距）。

screen.SKY_SCREEN=天空
screen.SKY_SCREEN.comment=包含天空相关设置（如体积光）。

screen.WAVING_SCREEN=摆动物体
screen.WAVING_SCREEN.comment=包含草、小麦、树叶等。

screen.MISC_SCREEN=杂项
screen.MISC_SCREEN.comment=包含调试功能及其他选项
#----------------------------------------------------
