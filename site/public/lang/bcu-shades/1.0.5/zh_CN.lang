value.POM_DISTANCE.512=512 §e[*]
value.POM_DISTANCE.1024=1024 §e[*]

option.POM_LIGHTING_MODE=POM 照明模式
option.POM_LIGHTING_MODE.comment=调整 POM 影响表面的光照风格。锐利：如果 POM 墙面未面向光源，则不会获得光照。平滑：POM 墙面仍会像非墙体一样获得光照。§e[*]§r 如果 POM 质量设为低于 100，此选项将强制为「平滑」。
value.POM_LIGHTING_MODE.1=平滑
value.POM_LIGHTING_MODE.2=锐利

option.POM_ALLOW_CUTOUT=§e在 Cutout 表面启用 POM §c[-]§r
option.POM_ALLOW_CUTOUT.comment=使 POM 能够在 Cutout 方块部分工作（如树叶间隙）。§c[-]§r 此效果可能严重影响性能。

option.DIRECTIONAL_BLOCKLIGHT=§e方向性方块光照§r
option.DIRECTIONAL_BLOCKLIGHT.comment=根据面法线为方块光照添加深度。 §c[-]§r 在某些情况下可能导致视觉瑕疵。 §c[-]§r 此效果可能影响性能。 §e[*]§r 资源包支持选项必须设置为 labPBR/seuspbr，且需使用兼容的资源包。
value.DIRECTIONAL_BLOCKLIGHT.0=关闭
value.DIRECTIONAL_BLOCKLIGHT.3=微弱 §c[-]
value.DIRECTIONAL_BLOCKLIGHT.7=正常 §c[-]
value.DIRECTIONAL_BLOCKLIGHT.11=强烈 §c[-]

option.HELD_LIGHTING_MODE=动态手持灯光
option.HELD_LIGHTING_MODE.comment=允许手持光源照亮场景。
value.HELD_LIGHTING_MODE.0=关闭
value.HELD_LIGHTING_MODE.1=柔和
value.HELD_LIGHTING_MODE.2=正常

option.BLOCKLIGHT_FLICKERING=区块光照闪烁
option.BLOCKLIGHT_FLICKERING.comment=为区块发出的光照添加闪烁效果。
value.BLOCKLIGHT_FLICKERING.0=关闭

option.WAVING_SPEED=摆动速度
option.WAVING_SPEED.comment=调整摆动效果的发生速度。

option.WAVING_I=摆动强度
option.WAVING_I.comment=调整方块摆动时的运动幅度。§c[-]§r摆动强度过大会导致方块在运动时与其他方块穿模。
value.WAVING_I.1.25=1.25 §c[-]
value.WAVING_I.1.50=1.50 §c[-]
value.WAVING_I.1.75=1.75 §c[-]
value.WAVING_I.2.00=2.00 §c[-]
value.WAVING_I.50.0=§cInsane

option.NO_WAVING_INDOORS=禁止在封闭区域挥动
option.NO_WAVING_INDOORS.comment=防止在封闭区域使用天光时方块挥动。§c[-]§r 启用此设置可能与某些资源包或模组产生冲突。

option.WAVING_I_RAIN_MULT=§e雨中挥动倍率§r
option.WAVING_I_RAIN_MULT.comment=乘以雨中挥动的速度与强度。§c[-]§r 挥动强度过高会导致挥动方块在其他方块内外穿模。§c[-]§r 该设置在数值超过100时可能影响性能。
value.WAVING_I.125=125 §c[-]
value.WAVING_I.150=150 §c[-]
value.WAVING_I.175=175 §c[-]
value.WAVING_I.200=200 §c[-]

option.WAVING_FOLIAGE=摇摆草地
option.WAVING_FOLIAGE.comment=为草地及其他相似植被添加运动效果，以模拟风的作用。

option.WAVING_LEAVES=摇晃树叶
option.WAVING_LEAVES.comment=为树叶添加移动效果，以模拟风的影响。

option.WAVING_LAVA=摆动的熔岩纹理
option.WAVING_LAVA.comment=为熔岩添加持续的 movement 效果。§e[*]§r 熔岩的摆动在 particular 不受 "在封闭区域禁止摆动" 设置的影响。

option.WAVING_LILY_PAD=摇摆荷叶 §c[-]§r
option.WAVING_LILY_PAD.comment=为荷叶和青蛙苗胞添加运动，模拟水波的冲击。 §c[-]§r 这是会导致水上潜水块上的荷叶变为不可见

option.WAVING_WATER_VERTEX=水面漂浮高度
option.WAVING_WATER_VERTEX.comment=为水面位置添加运动，模拟风的效果。§e[*]§r 此选项与「水波强度」设置无关。

option.WAVING_RAIN=摆动雨雪纹理
option.WAVING_RAIN.comment=为落下的雨雪纹理添加动态效果，使其看起来更加流畅。

option.SPECIAL_PORTAL_EFFECTS=特殊传送门特效
option.SPECIAL_PORTAL_EFFECTS.comment=为下界传送门、End 传送门以及 End 网关添加特殊动画和自发光效果。

option.REFLECTION_RES=§e反射分辨率§r
option.REFLECTION_RES.comment=更改PBR反射（以及世界空间反射，如果启用了该设置）的分辨率，以提升性能。 §c[-]§r "完整"分辨率的反射在某些情况下对性能影响远超预期。 §e[*]§r 此功能在Optifine上无法工作。
value.REFLECTION_RES.1.0=§4§l§n§o完整
value.REFLECTION_RES.0.5=§a一半

option.WORLD_OUTLINE=§e世界轮廓§r
option.WORLD_OUTLINE.comment=在方块周围添加亮色轮廓。 §c[-]§r 此效果可能影响性能。

option.WORLD_OUTLINE_THICKNESS=§e世界轮廓厚度§r
option.WORLD_OUTLINE_THICKNESS.comment=决定世界轮廓效果的厚度。§c[-]§r增加此设置会影响性能。

option.WORLD_OUTLINE_I=世界轮廓亮度
option.WORLD_OUTLINE_I.comment=决定世界轮廓效果的强度。

option.WORLD_OUTLINE_ON_ENTITIES=实体上的世界轮廓
option.WORLD_OUTLINE_ON_ENTITIES.comment=决定世界轮廓效果是否应用到实体上。§c[-]§r 此设置在某些自定义 PBR 资源包上可能无法完美工作。

option.WORLD_OUTLINE_SCALED=距离缩放的世界轮廓
option.WORLD_OUTLINE_SCALED.comment=使世界轮廓的大小随距离缩放。

option.DARK_OUTLINE=§e暗色轮廓§r
option.DARK_OUTLINE.comment=在方块周围添加暗色轮廓。§c[-]§r 此效果可能对性能产生影响。

option.DARK_OUTLINE_THICKNESS=§e暗色轮廓厚度§r
option.DARK_OUTLINE_THICKNESS.comment=决定暗色轮廓效果的厚度。§c[-]§r增加此设置会影响性能。

option.RAIN_PUDDLES=§e雨水积水§r
option.RAIN_PUDDLES.comment=在雨天为地形添加水坑。§c[-]§r 雨水积水会严重影响性能。
value.RAIN_PUDDLES.0=§a关闭
value.RAIN_PUDDLES.1=§c雨中积水
value.RAIN_PUDDLES.2=§c雨中全覆盖
value.RAIN_PUDDLES.3=§c始终积水
value.RAIN_PUDDLES.4=§c始终全覆盖

option.UNDERWATER_DISTORTION=水下扭曲
option.UNDERWATER_DISTORTION.comment=当摄像机处于水中时，添加屏幕上的轻微折射效果。

option.SELECT_OUTLINE=选中框轮廓
option.SELECT_OUTLINE.comment=确定方块选中框的颜色。
value.SELECT_OUTLINE.0=关闭
value.SELECT_OUTLINE.1=默认
value.SELECT_OUTLINE.2=彩虹
value.SELECT_OUTLINE.3=自定义颜色
value.SELECT_OUTLINE.4=多功能

option.SELECT_OUTLINE_AUTO_HIDE=自动隐藏选区轮廓
option.SELECT_OUTLINE_AUTO_HIDE.comment=当玩家主手未持有物品时，隐藏方块选区轮廓。

option.SELECT_OUTLINE_I=次亮度
option.SELECT_OUTLINE_R=次红
option.SELECT_OUTLINE_G=次绿
option.SELECT_OUTLINE_B=次蓝

option.MOON_PHASE_INF_LIGHT=月相夜间照明
option.MOON_PHASE_INF_LIGHT.comment=启用不同月相改变夜间照明亮度。

option.MOON_PHASE_INF_ATMOSPHERE=月相 夜间 大气
option.MOON_PHASE_INF_ATMOSPHERE.comment=启用不同月相改变夜间大气亮度。

option.MOON_PHASE_INF_REFLECTION=月相 月亮反射
option.MOON_PHASE_INF_REFLECTION.comment=启用不同月相改变月亮反射亮度。

option.MOON_PHASE_FULL=满月强度
option.MOON_PHASE_FULL.comment=调整满月阶段（最亮的阶段）下的月相影响。

option.MOON_PHASE_PARTIAL=半月强度
option.MOON_PHASE_PARTIAL.comment=调整半月在所有月相阶段（从满月到暗月）的影响程度。这是 Minecraft 中你最常看到的月相。

option.MOON_PHASE_DARK=暗月相强度
option.MOON_PHASE_DARK.comment=调整新月（最暗相）期间的月相影响力度。

option.CONNECTED_GLASS_EFFECT=连通玻璃效果
option.CONNECTED_GLASS_EFFECT.comment=使所有类型的玻璃相互连通。 §e[*]§r 此功能仅在性能设置中开启高级颜色追踪且系统支持时才有效。 §e[*]§r 当安装「Continuity」模组时，此功能会自动禁用。

option.PORTAL_EDGE_EFFECT=发光传送门边缘
option.PORTAL_EDGE_EFFECT.comment=为末地传送门和下界传送门添加自发光边框效果。§e[*]§r 此功能仅在性能设置中开启高级颜色追踪且系统支持时才可工作。

option.PUDDLE_VOXELIZATION=修复玻璃屋顶下水洼
option.PUDDLE_VOXELIZATION.comment=在启用雨水水洼设置时，防止玻璃屋顶密闭区域形成雨水水洼。§e[*]§r 此功能仅在启用高级颜色追踪且细节质量设置为高配或以上时有效。

option.COLORED_CANDLE_LIGHT=彩色蜡烛灯光
option.COLORED_CANDLE_LIGHT.comment=使蜡烛发出的灯光颜色与其底色相同。§e[*]§r 去饱和的蜡烛颜色变体将继续使用常规火焰颜色。

option.COLORED_LIGHT_SATURATION=彩色灯光饱和度
option.COLORED_LIGHT_SATURATION.comment=调整来自高级颜色追踪产生的颜色饱和度。§e[*]§r 不建议更改此数值，因为视觉效果在默认饱和度下设计得最为均衡。

option.COLORED_LIGHT_FOG=§e彩色光雾§r
option.COLORED_LIGHT_FOG.comment=向场景添加体积方块光雾，夜间或地下时最为明显。§e[*]§r 此功能仅在性能设置中的高级颜色追踪开启且系统支持时有效。§c[-]§r 此效果可能严重影响性能。

option.COLORED_LIGHT_FOG_I=光雾强度
option.COLORED_LIGHT_FOG_I.comment=决定彩色光雾的亮度。

option.LIGHT_COLOR_MULTS=§e照明颜色乘数
option.LIGHT_COLOR_MULTS.comment=允许自定义所有表面的照明颜色。

option.ATM_COLOR_MULTS=§e大气颜色乘数
option.ATM_COLOR_MULTS.comment=允许自定义大气颜色，主要在天空和雾中可见。

