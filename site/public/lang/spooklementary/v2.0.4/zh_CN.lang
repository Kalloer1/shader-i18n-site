value.shadowDistance.1024.0=§4§k-§r§4§l§n§o64 区块§r§4§k-

option.ENTITY_SHADOW=实体阴影
option.ENTITY_SHADOW.comment=启用实体和方块实体投射的阴影。“常规实体”包括动物和怪物，而“全部”选项还包括箱子等方块实体。§c[-]§r 实体阴影对性能的影响远超预期，在某些情况下会消耗超过 50% 的帧率。
value.ENTITY_SHADOW.-1=§a关闭
value.ENTITY_SHADOW.1=§c常规实体
value.ENTITY_SHADOW.2=§4§k-§r§4§l§n§o全部§r§4§k- §r§c[-]

option.DETAIL_QUALITY=细节质量
option.DETAIL_QUALITY.comment=调整多项影响性能的细节设置。调整以下内容的质量：水面材质、TAA、光照微调、星云、地狱风暴、末地光束、天空效果反射、雨天水坑精度、飘动效果、运动模糊。
value.DETAIL_QUALITY.0=§a低配
value.DETAIL_QUALITY.2=§e中配
value.DETAIL_QUALITY.3=§c高配

option.CLOUD_QUALITY=云朵质量
option.CLOUD_QUALITY.comment=调整“重塑”/“无界”云朵样式的光照、细节和采样质量。§e[*]§r 此设置仅适用于“重塑”或“无界”云朵样式。
value.CLOUD_QUALITY.0=§a关闭
value.CLOUD_QUALITY.1=§a低配
value.CLOUD_QUALITY.2=§e中配
value.CLOUD_QUALITY.3=§c高配

option.FXAA_DEFINE=抗锯齿 (FXAA)
option.FXAA_DEFINE.comment=启用快速近似抗锯齿 (FXAA)，这是一种使图像更平滑的特效。
value.FXAA_DEFINE.-1=§a关闭
value.FXAA_DEFINE.1=§e开启

option.SSAO_QUALI_DEFINE=边缘阴影 (SSAO) 质量
option.SSAO_QUALI_DEFINE.comment=调整屏幕空间环境光遮蔽 (SSAO) 的质量，它会在场景边缘添加额外的环境阴影。每个等级都会进一步减少 SSAO 的噪点伪影。
value.SSAO_QUALI_DEFINE.0=§a关闭
value.SSAO_QUALI_DEFINE.2=§e中配
value.SSAO_QUALI_DEFINE.3=§c高配

option.ANISOTROPIC_FILTER=纹理过滤
option.ANISOTROPIC_FILTER.comment=使用各向异性过滤改善多级渐远纹理的质量。§e[*]§r 确保您的“Mipmap Levels”视频设置已设为最大值 (4)，否则效果不会理想。
value.ANISOTROPIC_FILTER.0=§a关闭
value.ANISOTROPIC_FILTER.4=§e4x
value.ANISOTROPIC_FILTER.8=§e8x
value.ANISOTROPIC_FILTER.16=§4§l16x

option.COLORED_LIGHTING=高级色彩追踪 §e[*]§r
option.COLORED_LIGHTING.comment=使用体素化和泛光填充为方块光源添加颜色，并引入一些新的光源。§e[*]§r 此功能仅在 Iris 和受支持的平台上生效。§e[*]§r 如果“实时阴影”关闭，此设置将被禁用。§a[+]§r 高级颜色追踪系统还启用了其他一些功能，您可以在“其他”->“ACT 功能”菜单中单独启用/禁用它们。§c[-]§r 此效果的高区块值对性能的影响远超预期，每个等级的性能开销可能是前一等级的两倍以上。§c[-]§r 在处理非完整方块或模组方块时，彩色光照可能会导致一些光色泄漏问题。
value.COLORED_LIGHTING.0=§a关闭
value.COLORED_LIGHTING.128=§c4 区块
value.COLORED_LIGHTING.192=§c6 区块
value.COLORED_LIGHTING.256=§4§l8 区块
value.COLORED_LIGHTING.384=§4§l12 区块
value.COLORED_LIGHTING.512=§4§l§n§o16 区块
value.COLORED_LIGHTING.768=§4§l§n§o24 区块 §r§c[-]
