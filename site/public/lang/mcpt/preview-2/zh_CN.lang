screen.path_tracing = 路径追踪
option.MAX_BOUNCES = 最大反弹次数
option.MAX_BOUNCES.comment = 允许的最大反弹次数。
option.MIN_RUSSIAN_ROULETTE_PROBABILITY = 最小终止概率
option.MIN_RUSSIAN_ROULETTE_PROBABILITY.comment = 俄罗斯轮盘赌的最小终止概率。例如，0.05 的值表示每次反弹后至少有 5% 的终止概率。较高的值可以提升性能，但会增加收敛时间。
option.SUPPRESS_FIREFLIES = 抑制火蝇
option.SUPPRESS_FIREFLIES.comment = 通过限制第一次反弹后材料的粗糙度来减少火蝇的出现。

screen.pbr = PBR
option.EMISSIVE_BRIGHTNESS = 自发光亮度
option.EMISSIVE_BRIGHTNESS.comment = 应用于自发光材质的乘数。

screen.sun = 太阳
option.sunPathRotation = 太阳角度
option.sunPathRotation.comment = 应用于太阳轨迹的角度（以度为单位）。
option.SUN_SIZE_MULTIPLIER = 太阳大小
option.SUN_SIZE_MULTIPLIER.comment = 应用于太阳角半径的乘数。
option.SUN_IRRADIANCE_MULTIPLIER = 太阳亮度
option.SUN_IRRADIANCE_MULTIPLIER.comment = 应用于太阳光谱辐照度的乘数。
option.SUN_IS_VISIBLE = 太阳可见
option.SUN_IS_VISIBLE.comment = 切换太阳是否可见。

screen.camera = 相机
option.CAMERA_TYPE = 相机类型
value.CAMERA_TYPE.0 = 针孔
value.CAMERA_TYPE.1 = 薄透镜
value.CAMERA_TYPE.2 = 完整镜头系统
option.CAMERA_TYPE.comment = 使用的相机类型。针孔 - 最简单的相机（无景深）。薄透镜 - 类似针孔，但支持景深。完整镜头系统 - 模拟完整的双高斯镜头系统（注意此选项下视野和焦点被锁定）。
option.THIN_LENS_APERTURE_RADIUS = 薄透镜光圈半径
option.THIN_LENS_APERTURE_RADIUS.comment = 薄透镜相机使用的光圈半径（单位：米）。
option.THIN_LENS_FOCAL_POINT_DISTANCE = 薄透镜焦距
option.THIN_LENS_FOCAL_POINT_DISTANCE.comment = 薄透镜相机使用的焦距（单位：米）。
option.THIN_LENS_APERTURE_SIDES = 薄透镜光圈多边形
option.THIN_LENS_APERTURE_SIDES.comment = 多边形光圈使用的边数。值为 0 时启用圆形光圈。
option.LENS_SYSTEM_TYPE = 镜头系统类型
value.LENS_SYSTEM_TYPE.0 = 双高斯
value.LENS_SYSTEM_TYPE.1 = 鱼眼
value.LENS_SYSTEM_TYPE.2 = 变形
option.LENS_SYSTEM_TYPE.comment = 镜头系统相机类型所使用的镜头系统类型。
option.LENS_SYSTEM_CHROMATIC_ABBERATION_STRENGTH = 镜头系统色差强度
option.LENS_SYSTEM_CHROMATIC_ABBERATION_STRENGTH.comment = 镜头系统相机中的色差强度。
option.LENS_SYSTEM_FLARES = 镜头系统光晕
option.LENS_SYSTEM_FLARES.comment = 启用镜头光晕。
option.LENS_SYSTEM_FILM_PLANE_SCALE = 镜头系统胶片平面缩放
option.LENS_SYSTEM_FILM_PLANE_SCALE.comment = 应用于镜头系统相机胶片平面尺寸的缩放因子。
option.LENS_SYSTEM_ISO = 镜头系统 ISO
option.LENS_SYSTEM_ISO.comment = 应用于镜头系统相机的 ISO 值。
option.LENS_SYSTEM_INVERSE_EXPOSURE_TIME = 镜头系统曝光时间
option.LENS_SYSTEM_INVERSE_EXPOSURE_TIME.comment = 应用于镜头系统相机的倒数曝光时间。

screen.bloom = 泛光
option.ENABLE_BLOOM = 启用泛光
option.ENABLE_BLOOM.comment = 切换泛光。
option.BLOOM_STRENGTH = 泛光强度
option.BLOOM_STRENGTH.comment = 应用的泛光强度。

screen.atmosphere = 大气
option.EARTH_ALBEDO = 地球反照率
option.EARTH_ALBEDO.comment = 地球的反照率。
option.PLAYER_ALTITUDE = 海拔
option.PLAYER_ALTITUDE.comment = 玩家/世界的海拔高度（单位：米）。
option.AEROSOL_TURBIDITY = 浑浊度
option.AEROSOL_TURBIDITY.comment = 大气的浑浊度。
option.AEROSOL_PARTICLE_RADIUS = 气溶胶粒子半径
option.AEROSOL_PARTICLE_RADIUS.comment = 气溶胶粒子的半径（单位：微米）。

screen.fog = 体积雾
option.ENABLE_VOLUMETRIC_FOG = 启用体积雾
option.ENABLE_VOLUMETRIC_FOG.comment = 切换雾的开关。
option.FOG_PARTICLE_RADIUS = 雾粒子半径
option.FOG_PARTICLE_RADIUS.comment = 雾水滴的半径，单位为微米。
option.FOG_SCATTERING_COEFFICIENT = 雾散射系数
option.FOG_SCATTERING_COEFFICIENT.comment = 雾的散射系数。（警告：更高的数值会严重降低性能。）
option.FOG_ABSORPTION_COEFFICIENT = 雾吸收系数
option.FOG_ABSORPTION_COEFFICIENT.comment = 雾的吸收系数。
option.FOG_BASE_ALTITUDE = 雾基础高度
option.FOG_BASE_ALTITUDE.comment = 雾密度开始呈指数衰减的高度。
option.FOG_SCALE_HEIGHT = 雾缩放高度
option.FOG_SCALE_HEIGHT.comment = 雾密度的衰减因子（数值越低衰减越快）。

screen.water = 水
option.WATER_PARALLAX_AMPLITUDE_MULTIPLIER = 波浪振幅
option.WATER_PARALLAX_AMPLITUDE_MULTIPLIER.comment = 应用于波浪振幅的乘数。
option.WATER_PARALLAX_FREQUENCY_MULTIPLIER = 波浪频率
option.WATER_PARALLAX_FREQUENCY_MULTIPLIER.comment = 应用于波浪频率的乘数。
option.WATER_PARALLAX_STEPS = 视差步数
option.WATER_PARALLAX_STEPS.comment = 用于水视差计算中的光线步进步数。
option.WATER_ABSORPTION_INTENSITY = 吸收强度
option.WATER_ABSORPTION_INTENSITY.comment = 应用于水吸收系数的乘数。
option.WATER_SCATTERING_INTENSITY = 散射强度
option.WATER_SCATTERING_INTENSITY.comment = 应用于水散射系数的乘数。
option.WATER_PHASE_FUNCTION = 相位函数
value.WATER_PHASE_FUNCTION.0 = 瑞利
value.WATER_PHASE_FUNCTION.1 = Henyey-Greenstein
option.WATER_PHASE_FUNCTION.comment = 用于水散射的相位函数类型。
option.WATER_PHASE_G = 相位 g 参数
option.WATER_PHASE_G.comment = 用于亨耶-格林斯坦相位函数的 g 参数。

screen.tonemapping = 曝光/色调映射
option.ENABLE_AUTO_EXPOSURE = 启用自动曝光
option.ENABLE_AUTO_EXPOSURE.comment = 切换自动曝光。
option.AUTO_EXPOSURE_STRENGTH = 自动曝光强度
option.AUTO_EXPOSURE_STRENGTH.comment = 自动曝光的强度。例如，强度为 1.0 时会将平均亮度映射到中间灰（0.18），无论环境明暗如何；而强度为 0.5 则会对非常明亮或黑暗的场景进行补偿。
option.TONESCALE_EXPOSURE = 曝光
option.TONESCALE_EXPOSURE.comment = 在色调映射之前应用的曝光乘数。
option.TONESCALE_CONTRAST = 色调对比度
option.TONESCALE_CONTRAST.comment = 色调的对比度。
option.TONESCALE_RANGE = 色调范围
option.TONESCALE_RANGE.comment = 色调的范围。

screen.debug = 调试
option.DISPLAY_LUMINANCE_HISTOGRAM = 显示亮度直方图
option.FILTER_NANS = 过滤非数值
