# ============================================================================
# DOT SETTINGS
# ============================================================================

option.DITHER_DOT_SCALE=点尺度
option.DITHER_DOT_SCALE.comment=指数级缩放点大小。数值越大，点越大。
value.DITHER_DOT_SCALE.2.0=微小
value.DITHER_DOT_SCALE.3.0=极小
value.DITHER_DOT_SCALE.4.0=小
value.DITHER_DOT_SCALE.5.0=默认
value.DITHER_DOT_SCALE.6.0=大
value.DITHER_DOT_SCALE.7.0=巨大
value.DITHER_DOT_SCALE.8.0=逼真
value.DITHER_DOT_SCALE.9.0=庞大
value.DITHER_DOT_SCALE.10.0=最大

option.DITHER_SIZE_VARIABILITY=尺寸变异
option.DITHER_SIZE_VARIABILITY.comment=控制阴影对图案的影响方式。§e0§r = Bayer 式（点数变化）。§e1§r = 半色调式（点大小变化）。
value.DITHER_SIZE_VARIABILITY.0.0=Bayer 式
value.DITHER_SIZE_VARIABILITY.0.5=混合
value.DITHER_SIZE_VARIABILITY.1.0=半色调式

option.DITHER_DOT_CONTRAST=点状抗锯齿对比度
option.DITHER_DOT_CONTRAST.comment=控制点状边缘锐利度。§e1.0§r = 完美抗锯齿（推荐）。
value.DITHER_DOT_CONTRAST.0.0=模糊
value.DITHER_DOT_CONTRAST.0.5=柔和
value.DITHER_DOT_CONTRAST.1.0=抗锯齿（默认）
value.DITHER_DOT_CONTRAST.1.5=锐利
value.DITHER_DOT_CONTRAST.2.0=非常锐利

option.DITHER_STRETCH_SMOOTH=拉伸平滑度
option.DITHER_STRETCH_SMOOTH.comment=在浅角度下拉伸的各向异性点（圆点）平滑程度。
value.DITHER_STRETCH_SMOOTH.0.0=None
value.DITHER_STRETCH_SMOOTH.1.0=Default
value.DITHER_STRETCH_SMOOTH.2.0=Maximum

# ============================================================================
# BRIGHTNESS SETTINGS
# ============================================================================

option.DITHER_EXPOSURE=曝光
option.DITHER_EXPOSURE.comment=在 dithering 之前，对输入亮度应用的曝光乘数。
value.DITHER_EXPOSURE.0.0=黑
value.DITHER_EXPOSURE.0.5=极暗
value.DITHER_EXPOSURE.1.0=默认
value.DITHER_EXPOSURE.2.0=亮
value.DITHER_EXPOSURE.5.0=极亮

option.DITHER_OFFSET=偏移量
option.DITHER_OFFSET.comment=添加到输入亮度的偏移量。负数 = 变暗，正数 = 变亮。
value.DITHER_OFFSET.-1.0=最暗
value.DITHER_OFFSET.-0.5=更暗
value.DITHER_OFFSET.0.0=默认
value.DITHER_OFFSET.0.5=更亮
value.DITHER_OFFSET.1.0=最亮

# ============================================================================
# OPTIONS
# ============================================================================

option.PALETTE_COLOR_MATCH=颜色匹配
option.PALETTE_COLOR_MATCH.comment=如何将颜色映射到调色板。§e亮度§r = 按亮度 (清晰)。§e色彩感知§r = 按相似度 (保留色调)。
value.PALETTE_COLOR_MATCH.0=§7亮度§r
value.PALETTE_COLOR_MATCH.1=§b色彩感知§r

option.DITHER_INVERSE_DOTS=颗粒点反转
option.DITHER_INVERSE_DOTS.comment=交换点状颜色。§e关闭§r = 亮色点在暗色上。§e开启§r = 暗色点在亮色上。

option.DITHER_RADIAL_COMP=径向补偿
option.DITHER_RADIAL_COMP.comment=在相机旋转时稳定点密度。

option.DITHER_QUANTIZE_LAYERS=量化层数
option.DITHER_QUANTIZE_LAYERS.comment=防止渐变点形变。创建更锐利的过渡效果。

option.DITHER_DEBUG_FRACTAL=调试 分形
option.DITHER_DEBUG_FRACTAL.comment=显示每个像素正在使用的分形层。

