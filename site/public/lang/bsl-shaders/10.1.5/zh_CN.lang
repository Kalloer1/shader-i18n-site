#设置
option.ABOUT=BSL v10.1.5
option.ABOUT.comment=作者 Capt Tatsu。capttatsu.com
value.ABOUT.0=作者 Capt Tatsu

#光照
option.SHADOW=实时阴影
option.SHADOW.comment=启用实时的动态阴影贴图。

option.shadowMapResolution=阴影贴图质量
option.shadowMapResolution.comment=调整阴影贴图大小。§e[*]§r分辨率越高，阴影越锐利，但性能越低。
value.shadowMapResolution.512=极低 (0.5K)
value.shadowMapResolution.1024=低 (1K)
value.shadowMapResolution.1536=中低 (1.5K)
value.shadowMapResolution.2048=中 (2K)
value.shadowMapResolution.3072=高 (3K)
value.shadowMapResolution.4096=极高 (4K)
value.shadowMapResolution.8192=顶级 (8K)

option.shadowDistance=阴影距离
option.shadowDistance.comment=调整阴影渲染距离。
value.shadowDistance.128=8 区块
value.shadowDistance.192=12 区块
value.shadowDistance.256=16 区块
value.shadowDistance.384=24 区块
value.shadowDistance.512=32 区块
value.shadowDistance.768=48 区块
value.shadowDistance.1024=64 区块

option.SHADOW_COLOR=彩色阴影
option.SHADOW_COLOR.comment=启用半透明物体的着色阴影。§a[+]§r用于生成彩色体积光。§c[-]§r开启阴影过滤时性能开销略高。

option.SHADOW_FILTER=阴影过滤
option.SHADOW_FILTER.comment=启用阴影过滤。

option.AO=环境光遮蔽
option.AO.comment=在物体表面接触或相交处添加柔和阴影。

option.MULTICOLORED_BLOCKLIGHT=多彩方块光
option.MULTICOLORED_BLOCKLIGHT.comment=启用基于体素的多彩方块光。§e[*]§r需要实时阴影。§e[*]§r与 Mac 设备不兼容。

option.DESATURATION=去饱和
option.DESATURATION.comment=在较暗区域降低饱和度并添加些许色调。

option.DESATURATION_FACTOR=去饱和系数
option.DESATURATION_FACTOR.comment=调整去饱和效果的最大强度。
value.DESATURATION_FACTOR.2.0=极低
value.DESATURATION_FACTOR.1.5=低
value.DESATURATION_FACTOR.1.0=中
value.DESATURATION_FACTOR.0.5=高
value.DESATURATION_FACTOR.0.0=极高

option.DYNAMIC_HANDLIGHT=动态手持光源
option.DYNAMIC_HANDLIGHT.comment=允许手持特定物品时发出方块光。
value.DYNAMIC_HANDLIGHT.0=§c关
value.DYNAMIC_HANDLIGHT.1=仅手持
value.DYNAMIC_HANDLIGHT.2=完全

option.HALF_LAMBERT=半兰伯特
option.HALF_LAMBERT.comment=允许垂直于太阳/月亮方向的表面也接收光照。§e[*]§r会强制阴影偏置模式为“表面法线”。

#阴影高级设置
option.SHADOW_ENTITY=实体阴影
option.SHADOW_ENTITY.comment=启用生物的阴影。§e[*]§r当加载大量生物时建议关闭。§e[*]§r仅支持 1.16.5 及以上版本。

option.SHADOW_BLOCK_ENTITY=方块实体阴影
option.SHADOW_BLOCK_ENTITY.comment=启对方块实体的阴影。§e[*]§r当加载大量方块实体时建议关闭。§e[*]§r仅支持 1.16.5 及以上版本。

option.SHADOW_VEGETATION=植被阴影
option.SHADOW_VEGETATION.comment=启用草、农作物及其他植物的阴影。

option.SHADOW_CLOUD=云影
option.SHADOW_CLOUD.comment=启用云投射的阴影。

option.SHADOW_LOD=LOD 阴影
option.SHADOW_LOD.comment=为 Distant Horizons 与 Voxy 启用屏幕空间阴影。

option.sunPathRotation=太阳路径旋转
option.sunPathRotation.comment=调整太阳角度。

option.SHADOW_BIAS=阴影偏置模式
option.SHADOW_BIAS.comment=决定阴影贴图偏置的计算方式。光照方向模式能保留大部分阴影边缘，但远处阴影显得悬空；表面法线模式能保留接触点，但远处阴影显得更短。
value.SHADOW_BIAS.0=光照方向
value.SHADOW_BIAS.1=表面法线

option.SHADOW_PIXEL=像素锁定阴影
option.SHADOW_PIXEL.comment=对阴影应用像素化效果。
value.SHADOW_PIXEL.0=关

option.SHADOW_SKY_FALLOFF=伪阴影衰减
option.SHADOW_SKY_FALLOFF.comment=调整关闭实时阴影时伪阴影的锐利程度。
value.SHADOW_SKY_FALLOFF.0.6=极柔和
value.SHADOW_SKY_FALLOFF.0.6667=柔和
value.SHADOW_SKY_FALLOFF.0.7333=均衡
value.SHADOW_SKY_FALLOFF.0.8=锐利
value.SHADOW_SKY_FALLOFF.0.8667=极锐利

#环境光遮蔽设置
option.AO_METHOD=AO 计算方式
option.AO_METHOD.comment=决定环境光遮蔽的计算方式。
value.AO_METHOD.0=现代
value.AO_METHOD.1=经典

option.AO_STRENGTH=AO 强度
option.AO_STRENGTH.comment=调整环境光遮蔽强度。

option.ambientOcclusionLevel=原版 AO 强度
option.ambientOcclusionLevel.comment=调整原版环境光遮蔽强度。

#多彩方块光设置
option.MCBL_FOG=方块光体积雾
option.MCBL_FOG.comment=允许方块光发出体积雾。§e[*]§r需要体积光。

option.MCBL_FOG_STRENGTH=方块光体积雾强度
option.MCBL_FOG_STRENGTH.comment=调整方块光体积雾强度。

option.MCBL_DISTANCE=距离
option.MCBL_DISTANCE.comment=调整多彩方块光的距离。§e[*]§r垂直（Y 轴）范围上限为 256 格。
value.MCBL_DISTANCE.128=4 区块
value.MCBL_DISTANCE.192=6 区块
value.MCBL_DISTANCE.256=8 区块
value.MCBL_DISTANCE.384=12 区块
value.MCBL_DISTANCE.512=16 区块

option.MCBL_HALF_HEIGHT=半高
option.MCBL_HALF_HEIGHT.comment=将多彩方块光的垂直范围减半。

option.MCBL_RANDOM=随机颜色
option.MCBL_RANDOM.comment=为每个方块应用随机颜色。

option.MCBL_SS=屏幕空间多彩方块光
option.MCBL_SS.comment=启用屏幕空间多彩方块光。§e[*]§r仅支持 1.16.5 及以上版本。

option.MCBL_SS_MODE=屏幕空间多彩方块光模式
option.MCBL_SS_MODE.comment=决定传统多彩方块光的行为。“延伸”仅在超出多彩方块光距离时应用屏幕空间彩色光；“覆盖”则始终应用，与距离无关。强烈推荐“延伸”，“覆盖”仅供进阶用户。
value.MCBL_SS_MODE.0=延伸
value.MCBL_SS_MODE.1=覆盖

option.MCBL_SS_ANTI_BLEED=屏幕空间防渗色
option.MCBL_SS_ANTI_BLEED.comment=减少不必要的方块光颜色扩散。§c[-]§r可能使欠采样伪影更加明显。

#材质
option.ADVANCED_MATERIALS=高级材质
option.ADVANCED_MATERIALS.comment=启用高光与法线贴图，为各种物体带来更多细节。§e[*]§r需要包含高光/法线贴图的资源包，若未使用请关闭。§e[*]§r需要高级材质的选项以 * 标注，关闭高级材质后这些选项不会影响画面或性能。

option.MATERIAL_FORMAT=材质格式*
option.MATERIAL_FORMAT.comment=决定资源包使用的高光与法线贴图格式。§e[*]§r资源包作者通常会说明所用格式，格式选错可能出现异常效果。
value.MATERIAL_FORMAT.0=SEUS/旧版 PBR
value.MATERIAL_FORMAT.1=labPBR 1.3

option.SSS=次表面散射*
option.SSS.comment=允许光线穿透并在方块内部散射。§a[+]§r此效果受益于 TAA。

option.BASIC_SSS=基础散射
option.BASIC_SSS.comment=为特定方块启用简化版的次表面散射。

option.ENTITY_FLASH=实体闪光
option.ENTITY_FLASH.comment=为受伤实体和即将爆炸的苦力怕启用颜色叠加。

option.REFRACTION=折射
option.REFRACTION.comment=启用法线贴图透明表面后方的扭曲效果。§c[-]§r透明表面本身也会被扭曲。§c[-]§r启用后部分其他功能可能无法正常工作。
value.REFRACTION.0=关
value.REFRACTION.1=仅水面
value.REFRACTION.2=完全

option.ALBEDO_BALANCING=反照率平衡
option.ALBEDO_BALANCING.comment=降低过于明亮表面的亮度。

option.ALPHA_BLEND=Alpha 混合
option.ALPHA_BLEND.comment=决定透明混合的计算方式。
value.ALPHA_BLEND.0=伽马
value.ALPHA_BLEND.1=线性

#高光与反射
option.REFLECTION=反射
option.REFLECTION.comment=启用水面与半透明表面的反射。
value.REFLECTION.0=§c关
value.REFLECTION.1=仅天空与高光
value.REFLECTION.2=完全

option.REFLECTION_TRANSLUCENT=半透明反射
option.REFLECTION_TRANSLUCENT.comment=允许在半透明表面（如染色玻璃、冰、黏液块等）上渲染反射。

option.REFLECTION_MODE=反射模式
option.REFLECTION_MODE.comment=调整反射的表现方式。
value.REFLECTION_MODE.0=减少重复
value.REFLECTION_MODE.1=均衡
value.REFLECTION_MODE.2=更多补缝

option.REFLECTION_PREVIOUS=前帧反射
option.REFLECTION_PREVIOUS.comment=利用上一帧的信息渲染半透明物体的反射。§c[-]§r截图时反射可能缺失（由截图尺寸设置导致）。§c[-]§r与部分 GPU 不兼容。§c[-]§r在 1.7.10 中存在漏洞。

option.SPECULAR_HIGHLIGHT=高光
option.SPECULAR_HIGHLIGHT.comment=启用光滑表面上的亮斑。
value.SPECULAR_HIGHLIGHT.0=§c关
value.SPECULAR_HIGHLIGHT.1=仅不透明
value.SPECULAR_HIGHLIGHT.2=完全

option.REFLECTION_LOD=LOD 反射
option.REFLECTION_LOD.comment=决定反射中 Distant Horizons 与 Voxy 区块的质量。
value.REFLECTION_LOD.0=快速
value.REFLECTION_LOD.1=精细

option.REFLECTION_SKY_FALLOFF=天空反射衰减
option.REFLECTION_SKY_FALLOFF.comment=调整低天空光照下天空反射淡出的距离。
value.REFLECTION_SKY_FALLOFF.1=极柔和
value.REFLECTION_SKY_FALLOFF.2=柔和
value.REFLECTION_SKY_FALLOFF.4=均衡
value.REFLECTION_SKY_FALLOFF.8=锐利
value.REFLECTION_SKY_FALLOFF.16=极锐利

option.REFLECTION_SKYBOX=反射天空盒
option.REFLECTION_SKYBOX.comment=允许资源包天空盒进入反射。§c[-]§r天空盒仅应用于透明表面。

option.REFLECTION_SPECULAR=高光反射*
option.REFLECTION_SPECULAR.comment=启用光滑或金属表面的反射。

option.REFLECTION_ROUGH=粗糙反射*
option.REFLECTION_ROUGH.comment=允许光滑度较低的表面渲染模糊反射。§c[-]§r可能包含轻微瑕疵。

option.REFLECTION_RAIN=雨天反射*
option.REFLECTION_RAIN.comment=允许下雨时表面被打湿。§e[*]§r需要高光反射。

option.REFLECTION_RAIN_AMOUNT=水洼数量
option.REFLECTION_RAIN_AMOUNT.comment=调整下雨时产生的水洼数量。
value.REFLECTION_RAIN_AMOUNT.0.4=极低
value.REFLECTION_RAIN_AMOUNT.0.5=低
value.REFLECTION_RAIN_AMOUNT.0.6=中
value.REFLECTION_RAIN_AMOUNT.0.7=高
value.REFLECTION_RAIN_AMOUNT.1.0=极高

option.SPECULAR_HIGHLIGHT_ROUGH=粗糙高光*
option.SPECULAR_HIGHLIGHT_ROUGH.comment=允许粗糙表面呈现微弱光泽。

option.ALBEDO_METAL=labPBR 基色金属*
option.ALBEDO_METAL.comment=将基础纹理作为固定金属表面的着色。§e[*]§r仅支持 labPBR 材质格式。

#法线与视差
