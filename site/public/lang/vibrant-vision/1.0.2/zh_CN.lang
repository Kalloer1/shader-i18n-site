option.GLOWING_ORE_NETHERGOLD=发光的下界金矿石
option.GLOWING_ORE_GILDEDBLACKSTONE=发光的金质黑石
option.GLOWING_ORE_ANCIENTDEBRIS=发光的远古残骸
option.GLOWING_ORE_MODDED=发光模组矿石
option.GLOWING_ORE_MODDED.comment=§e[*]§r

option.GLOWING_AMETHYST=发光的紫水晶
value.GLOWING_AMETHYST.0=关闭
value.GLOWING_AMETHYST.1=水晶
value.GLOWING_AMETHYST.2=水晶和方块

option.GLOWING_LICHEN=发光地衣
value.GLOWING_LICHEN.0=关闭
value.GLOWING_LICHEN.1=仅在封闭区域
value.GLOWING_LICHEN.2=始终

option.EMISSIVE_REDSTONE_BLOCK=发光的红石块

option.EMISSIVE_LAPIS_BLOCK=发光的青金石块

option.GLOWING_ARMOR_TRIM=发光护甲镶嵌
option.GLOWING_ARMOR_TRIM.comment=使护甲镶嵌发光。§e[*]§r 此功能仅在 Iris 光影包中生效，因为 OptiFine 不支持护甲镶嵌检测。

option.NORMAL_MAP_STRENGTH=纹理深度
option.NORMAL_MAP_STRENGTH.comment=调整表面凹凸细节的强度。表面数据源必须设置为 labPBR，并使用兼容的资源包。

option.CUSTOM_EMISSION_INTENSITY=发射亮度
option.CUSTOM_EMISSION_INTENSITY.comment=调整 labPBR 发光表面的亮度强度。表面数据源必须设置为 labPBR，且必须使用兼容的资源包。

option.POM=视差
option.POM.comment=为 labPBR 表面添加视觉深度。此效果可能严重影响性能，且需要兼容的 labPBR 资源包。
value.POM.false=关闭
value.POM.true=开启

option.POM_DEPTH=视差深度
option.POM_DEPTH.comment=调整来自兼容 labPBR 资源包的视差映射的视觉深度。

option.POM_QUALITY=视差质量
option.POM_QUALITY.comment=调整视差精度。数值高于 200 会严重影响性能；数值低于 100 会强制使用平滑光照。需要兼容的 labPBR 资源包。
value.POM_QUALITY.16=16
value.POM_QUALITY.32=32
value.POM_QUALITY.64=64
value.POM_QUALITY.256=256
value.POM_QUALITY.512=512

option.POM_DISTANCE=视差距离
option.POM_DISTANCE.comment=调整视差贴图的计算范围。将此值保持在 50 以下可节省部分 GPU 资源。需要兼容的 labPBR 资源包。
value.POM_DISTANCE.64=64
value.POM_DISTANCE.128=128
value.POM_DISTANCE.256=256
value.POM_DISTANCE.512=512
value.POM_DISTANCE.1024=1024

option.POM_LIGHTING_MODE=视差光照
option.POM_LIGHTING_MODE.comment=调整视差表面的光照响应。锐利 尊重表面的朝向；平滑 保持原始表面光照。低视差细节强制使用平滑。
value.POM_LIGHTING_MODE.1=平滑
value.POM_LIGHTING_MODE.2=锐利

option.POM_ALLOW_CUTOUT=视差裁剪
option.POM_ALLOW_CUTOUT.comment=使 POM 能够在裁剪块区域（如树叶间隙）上生效。§c[-]§r 此效果可能严重影响性能。

option.DIRECTIONAL_BLOCKLIGHT=方向性方块光
option.DIRECTIONAL_BLOCKLIGHT.comment=为 labPBR 法线添加方向敏感的方块光深度。可能消耗性能，并可能在不寻常的法线贴图上显示出瑕疵。
value.DIRECTIONAL_BLOCKLIGHT.0=关闭
value.DIRECTIONAL_BLOCKLIGHT.3=微弱
value.DIRECTIONAL_BLOCKLIGHT.7=正常
value.DIRECTIONAL_BLOCKLIGHT.11=强烈

option.HELD_LIGHTING_MODE=手持光源
option.HELD_LIGHTING_MODE.comment=允许手持光源为场景投射光照.
value.HELD_LIGHTING_MODE.0=关闭
value.HELD_LIGHTING_MODE.1=柔和
value.HELD_LIGHTING_MODE.2=正常

option.VV_FLASHLIGHT=手电筒
option.VV_FLASHLIGHT.comment=从相机处投射出一个温暖的光束锥。这与手持物品无关，默认禁用。
option.VV_FLASHLIGHT_STRENGTH=亮度
option.VV_FLASHLIGHT_STRENGTH.comment=控制相机中心光束的强度。
option.VV_FLASHLIGHT_RANGE=距离
option.VV_FLASHLIGHT_RANGE.comment=控制光束淡出的距离。
option.VV_FLASHLIGHT_WIDTH=宽度
option.VV_FLASHLIGHT_WIDTH.comment=控制锥体边缘。数值越低，光束越宽；数值越高，光束越窄。

option.BLOCKLIGHT_FLICKERING=方块光闪烁
option.BLOCKLIGHT_FLICKERING.comment=为方块发出的光添加闪烁效果。
value.BLOCKLIGHT_FLICKERING.0=关闭

option.WAVING_SPEED=移动速度
option.WAVING_SPEED.comment=调整波浪效果出现的速度。

option.WAVING_I=移动强度
option.WAVING_I.comment=调整波动的块的移动幅度。§c[-]§r 过大的波纹强度可能导致波纹块与其他块产生重叠。
value.WAVING_I.1.25=1.25
value.WAVING_I.1.50=1.50
value.WAVING_I.1.75=1.75
value.WAVING_I.2.00=2.00
value.WAVING_I.50.0=最大值

option.NO_WAVING_INDOORS=室内移动
option.NO_WAVING_INDOORS.comment=阻止方块在封闭区域内因天光而飘动。§c[-]§r 启用此设置可能会导致某些资源包或模组出现问题。

option.WAVING_I_RAIN_MULT=雨水运动
option.WAVING_I_RAIN_MULT.comment=在雨天时，乘以波纹的速度和强度。§c[-]§r 过高的波纹强度可能导致波纹方块与其他方块重叠或错位。§c[-]§r 当数值超过 100 时，可能会影响性能。
value.WAVING_I.125=125
value.WAVING_I.150=150
value.WAVING_I.175=175
value.WAVING_I.200=200

option.WAVING_FOLIAGE=草的摆动
option.WAVING_FOLIAGE.comment=为草和其他类似的植被添加运动效果，模拟风的吹动。

option.WAVING_LEAVES=树叶飘动
option.WAVING_LEAVES.comment=使树叶产生飘动效果，模拟风的移动。

option.WAVING_LAVA=岩浆移动
option.WAVING_LAVA.comment=为岩浆添加持续的移动效果。§e[*]§r 特别是岩浆的波动不会受到“No Surface Motion in Closed Areas”设置的影响。

option.WAVING_LILY_PAD=莲叶移动
option.WAVING_LILY_PAD.comment=为莲叶和蛤蛤卵添加移动效果，以模拟水波的影响。§c[-]§r 这会导致莲叶在水淹方块上变得不可见

option.WAVING_WATER_VERTEX=水面动态
option.WAVING_WATER_VERTEX.comment=使水面产生移动，模拟风的效果。§e[*]§r 此选项与“水波强度”设置无关。

option.WAVING_RAIN=雨雪动态效果
option.WAVING_RAIN.comment=为降落的雨雪纹理添加动态效果，使其看起来更生动。

option.SPECIAL_PORTAL_EFFECTS=门户特效
option.SPECIAL_PORTAL_EFFECTS.comment=为下界门、末地门和末地网关添加特殊动画和发射效果。

option.REFLECTION_RES=反射质量
option.REFLECTION_RES.comment=调整 PBR 反射在方块（以及已启用世界空间反射时）上的分辨率以提升性能。 §c[-]§r “全”分辨率反射在某些情况下可能比预期更严重影响性能。 §e[*]§r 此功能在 OptiFine 上不可用。
value.REFLECTION_RES.1.0=全
value.REFLECTION_RES.0.5=半

option.WORLD_OUTLINE=世界轮廓
option.WORLD_OUTLINE.comment=为方块添加明亮的轮廓。§c[-]§r 此效果可能会影响性能。

option.WORLD_OUTLINE_THICKNESS=轮廓宽度
option.WORLD_OUTLINE_THICKNESS.comment=控制世界轮廓的宽度。更宽的轮廓会消耗更多性能。

option.WORLD_OUTLINE_I=轮廓亮度
option.WORLD_OUTLINE_I.comment=控制世界轮廓的亮度。

option.WORLD_OUTLINE_ON_ENTITIES=实体轮廓
option.WORLD_OUTLINE_ON_ENTITIES.comment=将世界轮廓应用于实体。某些材质资源包可能无法正确支持此功能。

option.WORLD_OUTLINE_SCALED=距离缩放
option.WORLD_OUTLINE_SCALED.comment=使世界轮廓的大小根据距离进行缩放。

option.DARK_OUTLINE=暗边框
option.DARK_OUTLINE.comment=在方块周围添加暗边框。 §c[-]§r 此效果可能会影响性能。

option.DARK_OUTLINE_THICKNESS=暗描边宽度
option.DARK_OUTLINE_THICKNESS.comment=决定暗描边效果的粗细。§c[-]§r 提高此设置可能会影响性能。

option.RAIN_PUDDLES=积水
option.RAIN_PUDDLES.comment=在雨天为地形添加积水。 §c[-]§r 雨后积水可能严重影响性能。
value.RAIN_PUDDLES.0=关闭
value.RAIN_PUDDLES.1=雨天有积水
value.RAIN_PUDDLES.2=雨天全覆盖
value.RAIN_PUDDLES.3=始终有积水
value.RAIN_PUDDLES.4=始终全覆盖

option.UNDERWATER_DISTORTION=水下畸变
option.UNDERWATER_DISTORTION.comment=在摄像机位于水下时为屏幕添加微妙的折射效果。

option.SELECT_OUTLINE=选区轮廓
option.SELECT_OUTLINE.comment=决定方块选区的轮廓颜色。
value.SELECT_OUTLINE.0=关闭
value.SELECT_OUTLINE.1=默认
value.SELECT_OUTLINE.3=选择颜色
value.SELECT_OUTLINE.4=多功能

option.SELECT_OUTLINE_AUTO_HIDE=隐藏选区轮廓
option.SELECT_OUTLINE_AUTO_HIDE.comment=当玩家主手未持有任何物品时隐藏方块选区轮廓。

option.SELECT_OUTLINE_I=亮度
