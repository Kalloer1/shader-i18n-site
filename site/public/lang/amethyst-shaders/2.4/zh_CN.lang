value.DIRECTIONAL_BLOCKLIGHT.3=微弱 §c[-]
value.DIRECTIONAL_BLOCKLIGHT.7=普通 §c[-]
value.DIRECTIONAL_BLOCKLIGHT.11=强烈 §c[-]

option.HELD_LIGHTING_MODE=动态手持照明
option.HELD_LIGHTING_MODE.comment=允许手持光源向场景投射光线。
value.HELD_LIGHTING_MODE.0=§c关闭
value.HELD_LIGHTING_MODE.1=微弱
value.HELD_LIGHTING_MODE.2=正常

option.BLOCKLIGHT_FLICKERING=方块光闪烁
