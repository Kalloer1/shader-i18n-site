option.LS_MOON_COLOR_G=月球绿色
option.LS_MOON_COLOR_B=月球蓝色
option.LS_AMBIENT_COLOR_R=环境红光
option.LS_AMBIENT_COLOR_G=环境绿
option.LS_AMBIENT_COLOR_B=环境光蓝色
option.LS_BLOCK_COLOR_R=方块红色
option.LS_BLOCK_COLOR_G=方块绿色
