option.LM_FLICKER=光照图闪烁
option.LM_FLICKER_STRENGTH=闪烁强度
option.HANDHELD_FALLOFF_CURVE=手持物强度
option.MOON_PHASE_INFLUENCE=月相影响
option.MOON_PHASE_INFLUENCE.comment=根据月相使月光变弱。值为1将在新月时完全禁用月光。
option.sunPathRotation=太阳旋转
suffix.sunPathRotation=°
option.RAIN_SKY_DARKENING=雨中变暗
option.RAIN_SKY_DESATURATION=雨中脱色
option.RAINBOWS=彩虹
option.RAINBOWS.comment=在一天中的特定时间添加彩虹。
option.RAINBOW_STRENGTH=彩虹强度
option.CUSTOM_SKYBOXES=自定义天空盒
option.CUSTOM_SKYBOXES.comment=允许资源包绘制自己的天空盒，而不是 mellow 的自定义天空。此选项会禁用其他效果，如云、边界雾等。
option.CUSTOM_SKYBOX_BRIGHTNESS=天空盒亮度
option.COLOR_SCHEME=配色方案
option.COLOR_SCHEME.comment=预定义的配色方案，受"颜色"选项卡中设置的影响。
option.AURORA_BOREALIS=极光
option.AURORA_BOREALIS.comment=在夜间添加极光效果（默认仅在雪地群系中显示）。
option.AURORA_STRENGTH=极光强度
option.AURORA_HEIGHT=极光高度
option.AURORA_EVERYWHERE=所有群系极光
option.DOF=景深
option.DOF.comment=模糊不在相机焦点上的物体。
option.DOF_APERTURE_SIZE=光圈大小
option.DOF_APERTURE_SIZE.comment=控制对焦范围的窄度。
option.DOF_BLUR_QUALITY=质量
option.DOF_FOCUS_ADJUSTMENT_SPEED=对焦调整速度
option.DOF_MANUAL_FOCUS=手动对焦
option.DOF_FOCUS_DISTANCE=手动对焦距离
