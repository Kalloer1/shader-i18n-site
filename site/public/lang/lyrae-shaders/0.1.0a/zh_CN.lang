value.POST_AUTO_EXPOSURE.0 = 关闭
value.POST_AUTO_EXPOSURE.1 = 开启
option.POST_BRIGHTNESS = 亮度
option.POST_BRIGHTNESS.comment = §bⓘ§r 色彩分级管线的一部分\n整体图像亮度\n0.0 为中性值，不会产生影响\n\n⌚ 影响: §a§l可忽略§r
option.POST_CONTRAST = 对比度
option.POST_CONTRAST.comment = §bⓘ§r 色彩分级管线的一部分\n围绕中灰色调轴进行，对比暗部与亮部\n1.0 为中性值，不会产生影响\n\n⌚ 影响: §a§l可忽略§r
