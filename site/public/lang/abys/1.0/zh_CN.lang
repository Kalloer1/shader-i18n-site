#shaders/lang/zh_CN.lang
# Abyss v1.0 简体中文翻译（AI 初翻，未人工校对）
# 源文件：Abyss.zip 的 shaders/lang/en_us.lang
screen.WATER=水
screen.LAMP=探照灯
screen.LIFE=生命
screen.SNOW=海洋雪
screen.FINISH=完成

profile.BATHYAL=半深海带
profile.MIDNIGHT=午夜带
profile.TRENCH=超深渊海沟
profile.BRINE_POOL=卤水池
profile.KELP_NIGHT=夜间海带林

option.WATER_TYPE=水
value.WATER_TYPE.0=Jerlov I - 开阔深渊
value.WATER_TYPE.1=近岸绿水
value.WATER_TYPE.2=超深渊泥沙
value.WATER_TYPE.3=缺氧卤水
option.WATER_TYPE.comment=按通道吸收。红色在几米内消亡，绿色存续更久，蓝色传播最远——深海呈现蓝色只因如此。
option.TURBIDITY=浑浊度
option.DOWNWELLING=下行光
option.DOWNWELLING.comment=四千米上方残留的日光。在真正的深渊中一丝也没有。

option.LAMP_POWER=探照灯功率
option.LAMP_REACH=探照灯射程
option.LAMP_REACH.comment=光束因平方反比定律衰减至无之处。
option.LAMP_CONE=光束锥角
option.LAMP_BACKSCATTER=后向散射
option.LAMP_BACKSCATTER.comment=光束照亮了你与观察目标之间的水体。每个潜水员都讨厌它，但它无处不在。

option.BIO_COLOR=发光
value.BIO_COLOR.0=青色值
value.BIO_COLOR.1=冷蓝色
value.BIO_COLOR.2=绿
value.BIO_COLOR.3=龙鱼红
option.BIO_COLOR.comment=红色是最特殊的。龙鱼自带红色探照灯，因为这里几乎没有生物能看见红光，于是它用猎物无法察觉的灯来捕猎。
option.BIO_GLOW=群落亮度
option.BIO_SCALE=群落尺度
option.BIO_PATCHY=斑块度
option.BIO_PATCHY.comment=岩石被群落覆盖的程度。数值越高，仅剩孤立的发光团。
option.BIO_PULSE=发光波
option.BIO_PULSE.comment=甲藻受扰即发光，响应以波的形式传遍群落。这就是受扰的发光群落看起来像在呼吸的原因。
option.EMIT_GAIN=自发光增益
option.EMIT_GAIN.comment=本就自发光的物体在此处的发光强度。

option.SNOW_LAYERS=雪壳层数
option.SNOW_LAYERS.comment=对水体纵深采样多少个距离层。层数越多，雪越密越平滑，开销越大。
option.SNOW_NEAR=最近雪花
option.SNOW_FAR=最远雪花
option.SNOW_DENSITY=雪花密度
option.SNOW_SIZE=雪花大小
option.SINK_RATE=下沉速率
option.SINK_RATE.comment=自有海洋以来，海洋雪便一直在飘落，从未停歇。

option.GLOW_STRENGTH=散射光晕
option.GLOW_THRESHOLD=光晕阈值
option.GLOW_THRESHOLD.comment=故意设得很低。这里值得看的东西大多都很微弱。
option.GLOW_RADIUS=光晕范围
option.PRESSURE_VIGNETTE=暗角
