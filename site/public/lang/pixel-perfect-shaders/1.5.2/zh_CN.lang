screen.SHADOWS=阴影
    screen.SHADOWS.comment=控制实时阴影贴图的阴影。

    option.SHADOWS_ENABLED_USER=已启用
        value.SHADOWS_ENABLED_USER.true=开
        value.SHADOWS_ENABLED_USER.false=关

    option.PIXELATED_SHADOWS_USER=像素化阴影覆盖
        option.PIXELATED_SHADOWS_USER.comment=使阴影像素化以与方块上的像素匹配。灵感来源于Complementary的像素化阴影，但实现方式为独立开发。启用后➤轻微性能下降。
        value.PIXELATED_SHADOWS_USER.0=关
        value.PIXELATED_SHADOWS_USER.8=8×8
        value.PIXELATED_SHADOWS_USER.16=16×16
        value.PIXELATED_SHADOWS_USER.32=32×32
        value.PIXELATED_SHADOWS_USER.64=64×64
        value.PIXELATED_SHADOWS_USER.128=128×128
        value.PIXELATED_SHADOWS_USER.256=256×256
        value.PIXELATED_SHADOWS_USER.512=512×512
        value.PIXELATED_SHADOWS_USER.1024=1024×1024

    option.shadowDistance=阴影距离
        option.shadowDistance.comment=阴影可显示的最远距离（以方块为单位）。由于提高距离意味着相同的阴影图像会覆盖更多方块，距离增加时阴影细节会降低。提高距离➤对性能无影响。

    option.entityShadowDistanceMul=实体阴影距离
        option.entityShadowDistanceMul.comment=实体停止投射阴影前的最远距离。与阴影距离不同，此设置不会改变阴影质量。提高距离➤轻微性能下降（取决于世界中的实体数量）。

    option.shadowMapResolution=阴影分辨率
        option.shadowMapResolution.comment=控制阴影贴图（阴影图像）的分辨率。更高分辨率的阴影贴图会增加阴影细节并使其更清晰。但更高分辨率需要更长计算时间，会降低性能。提高分辨率➤性能大幅下降。

    option.SHADOW_SUPERSAMPLE=阴影时域超分辨率
        option.SHADOW_SUPERSAMPLE.comment=阴影时域超分辨率通过多帧更新阴影来提升性能。此设置提高时，部分阴影可能不会立即更新。阴影更新速度取决于帧率，因此建议在4×设置下保持60+ FPS。提高设置➤性能大幅提升。
        value.SHADOW_SUPERSAMPLE.0=关
        value.SHADOW_SUPERSAMPLE.1=2×
        value.SHADOW_SUPERSAMPLE.2=4×

    option.SHADOW_DISTORTION=阴影扭曲
        option.SHADOW_DISTORTION.comment=由于远处物体显得更小，阴影贴图（阴影图像）会进行扭曲，使靠近玩家的区域拥有更高分辨率。较低扭曲度会使分辨率显得降低，而较高分辨率可能产生异常效果。提高设置➤对性能无影响。

    option.SHADOW_FILTERING=滤镜
        option.SHADOW_FILTERING.comment=通过模糊处理使阴影更美观。PCF➤中等至大幅性能下降（取决于采样数量）。双线性滤波➤轻微性能下降。
        value.SHADOW_FILTERING.0=关
        value.SHADOW_FILTERING.1=百分比接近过滤
        value.SHADOW_FILTERING.2=VP精简§c版（实验性功能）
        value.SHADOW_FILTERING.3=VP§c（实验性功能）
        value.SHADOW_FILTERING.4=双线性
        value.SHADOW_FILTERING.5=像素化

    option.SHADOW_FILTERING_RADIUS=滤波半径
        option.SHADOW_FILTERING_RADIUS.comment=阴影模糊程度（若启用滤波）。提高数值➤对性能无影响。

    option.SHADOW_FILTERING_SAMPLES=采样数量
        option.SHADOW_FILTERING_SAMPLES.comment=更多采样可使阴影模糊更柔和（若启用滤波）。提高采样数量➤性能大幅下降。
        
    option.GRASS_CASTS_SHADOWS=草地阴影
        option.GRASS_CASTS_SHADOWS.comment=控制草丛是否投射阴影。启用后➤对性能无影响。
        value.GRASS_CASTS_SHADOWS.true=开
        value.GRASS_CASTS_SHADOWS.false=关

    option.SHADOW_AFFECTED_BY_LIGHTMAP=原版光照影响阴影
        option.SHADOW_AFFECTED_BY_LIGHTMAP.comment=为避免“阴影泄漏”并模拟水或染色玻璃等物体的吸光效果，基于原版天空光等级增强阴影。对性能无影响。
        value.SHADOW_AFFECTED_BY_LIGHTMAP.true=开
        value.SHADOW_AFFECTED_BY_LIGHTMAP.false=关

