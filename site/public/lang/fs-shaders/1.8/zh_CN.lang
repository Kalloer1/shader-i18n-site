option.SHADOW_PIXEL_SIZE=§4§l§f§l像素化§f§l阴影尺寸
value.SHADOW_PIXEL_SIZE.8.0=8 [像素]
value.SHADOW_PIXEL_SIZE.16.0=16 [像素]
value.SHADOW_PIXEL_SIZE.32.0=32 [像素]
value.SHADOW_PIXEL_SIZE.64.0=64 [像素]
value.SHADOW_PIXEL_SIZE.128.0=128 [像素]
option.BLOOM_STYLE =泛光
value.BLOOM_STYLE.1 =解码
value.BLOOM_STYLE.2 =启示
value.BLOOM_STYLE.3 =SEUS着色器
value.BLOOM_STYLE.4 =迭代次数


#--# PC Performance #----------------------------------------------------------#

option.PC_PERFORMANCE=§4§l电§f§l脑性能
option.PC_PERFORMANCE.comment=主质量预设。该选项覆盖单独设置，请先选择此项再进行精细调整。马铃薯模式：§8仅调§f整光照与天空，关闭所有高耗能效果。低配模式：真实水面§a，§f优化光照与天空。中配模式：资源包§b默认§f配置。超级模式§6：中§f配模式加上高挺摇曳的真实草叶。终§c极§f模式：超级模式加上水面与湿地镜面级反射效果。
value.PC_PERFORMANCE.0=§8土豆
value.PC_PERFORMANCE.1=§a低
value.PC_PERFORMANCE.2=§b中
value.PC_PERFORMANCE.3=§6超级模式
value.PC_PERFORMANCE.4=§c终极模式

#--# Grass Block Blades #-----------------------------------------------------#

screen.Grass=§4§l§f§l草§f§l叶
screen.Grass.comment=在草方块顶部生成真实草叶几何体，取代平坦绿色表面。超级与终极模式自动启用此功能。

option.GRASS_BLADES=§4§l§f§l草§f§l叶
option.GRASS_BLADES.comment=主开关。在范围内所有草方块顶面散布草叶几何体。草叶采样方块自身顶部纹理，因此会遵循你的资源包与群系配色。
option.GRASS_BLADE_COUNT=§4§l§f§l草叶§f§l密度
option.GRASS_BLADE_COUNT.comment=每三角形生成的草叶数。方块顶部为两个三角形，因此每个方块承载两倍于此数值的草叶。此选项最影响性能——若帧率下降请优先降低此值。
option.GRASS_BLADE_HEIGHT=§4§l§f§l草叶§f§l高度
option.GRASS_BLADE_HEIGHT.comment=草叶高度（以方块为单位）。0.55约为脚踝高度，1.0呈现为野生草甸效果。
option.GRASS_BLADE_HEIGHT_VARIATION=§4§l§f§l高度§f§l变化
option.GRASS_BLADE_HEIGHT_VARIATION.comment=单株草叶随机高度差。设为0时所有草叶等高，田地呈现修剪过的外观。
option.GRASS_BLADE_WIDTH=§4§l§f§l草叶§f§l宽度
option.GRASS_BLADE_WIDTH.comment=草叶根部宽度（以方块为单位）。较宽的草叶能更好遮盖地面但显得粗糙。
option.GRASS_BLADE_LEAN=§4§l§f§l草叶倾§f§l斜度
option.GRASS_BLADE_LEAN.comment=单株草叶静态倾斜值（占草叶高度的比例）。适度倾斜可避免田地呈现钉床般生硬感。
option.GRASS_BLADE_DISTANCE=§4§l§f§l草叶生§f§l成距离
option.GRASS_BLADE_DISTANCE.comment=超过此方块数停止生成草叶，最后四分之一范围内渐隐以避免突兀。性能消耗与此值的平方近似成正比。
option.GRASS_NORMAL_TILT=§4§l§f§l法线倾§f§l斜
option.GRASS_NORMAL_TILT.comment=草叶法线向世界坐标上方的倾斜程度。较高值使田地呈现为柔顺捕光的整体表面；较低值使每株草叶成为独立棱面。
option.GRASS_WIND_STRENGTH=§4§l§f§l风力§f§l强度
option.GRASS_WIND_STRENGTH.comment=风力对草叶顶端的推动幅度。
option.GRASS_WIND_SPEED=§4§l§f§l风§f§l速
option.GRASS_WIND_SPEED.comment=阵风场与单株颤动的速率。
option.GRASS_ROOT_SHADE=§4§l§f§l茎部§f§l着色
option.GRASS_ROOT_SHADE.comment=草叶基部的暗化处理——该区域几乎无光照。在茂密草场中是最强的景深暗示。
option.GRASS_TIP_BRIGHTNESS=§4§l§f§l顶§f§l端亮度
option.GRASS_TIP_BRIGHTNESS.comment=草叶顶端的增亮效果，模拟光线穿透草叶的视觉表现。
option.GRASS_COLOR_VARIATION=§4§l§f§l色调§f§l变化
option.GRASS_COLOR_VARIATION.comment=单株草叶的色调差异，避免大片区域呈现单一平面色彩。

#--# Water Reflections #-------------------------------------------------------#

option.WATER_REFLECTION_BOOST=§4§l§f§l镜面§f§l水体
option.WATER_REFLECTION_BOOST.comment=使水体菲涅尔参数趋近完整镜面并增强反射光。水体随反射性增强变得更加不透明。终极模式自动启用此功能。
option.WATER_REFLECTION_FRESNEL=§4§l§f§l镜面§f§l强度
option.WATER_REFLECTION_FRESNEL.comment=菲涅尔参数向1.0的偏移程度。设为1.0时水体在所有观察角度保持相同反射率。
option.WATER_REFLECTION_GAIN=§4§l§f§l反射增§f§l益
option.WATER_REFLECTION_GAIN.comment=反射辐射度的倍增系数。超过约2.0高光部分将出现过曝。

value.GI_RSM.0=§c关
value.GI_RSM.1=§a开

#--# End Fog #-----------------------------------------------------------------#

screen.EndFog=§4§l末§f§l地§f§l之雾
screen.EndFog.comment=末地的雾气颜色。同时应用于体积雾与距离雾。

option.END_FOG_TINT=§4§l§f§l末地§f§l雾气§f§l色调
option.END_FOG_TINT.comment=重新着色末地的雾气。资源包自带的雾气偏暖，因此采用色调替换而非叠加——亮度和浓度保持不变。关闭时恢复原始暖色调。
option.END_FOG_COLOR_R=§4§l§f§l红
option.END_FOG_COLOR_R.comment=雾气色调的红色分量。
option.END_FOG_COLOR_G=§4§l§f§l绿
option.END_FOG_COLOR_G.comment=雾气色调的绿色分量。
option.END_FOG_COLOR_B=§4§l§f§l蓝
option.END_FOG_COLOR_B.comment=雾气色调的蓝色分量。默认值 0.55 / 0.18 / 1.0 对应饱和紫罗兰色。
option.END_FOG_TINT_STRENGTH=§4§l§f§l色调§f§l强度
option.END_FOG_TINT_STRENGTH.comment=雾气向色调偏移的程度。0 表示完全保留资源包原始的暖色雾气，1 表示完全使用选定的颜色。

#--# End Vortex #--------------------------------------------------------------#

screen.EndVortex=§4§l§f§l漩§f§l涡
screen.EndVortex.comment=末地主岛上空的发光雾柱。需启用“超级”或“神级”预设。致谢 x0nk 的 Bliss 效果。

option.END_VORTEX=§4§l§f§l漩§f§l涡
option.END_VORTEX.comment=在主岛上空放置一盏灯光，使末地雾气自行照亮。灯光正下方的雾气拥有清晰光路保持明亮；侧面的雾气则被中间的雾气遮蔽而变暗。这正是形成漏斗状效果的原理。
option.END_VORTEX_SAMPLES=§4§l§f§l采样数
option.END_VORTEX_SAMPLES.comment=光线步进穿过雾柱的步数。此为该效果的主要性能消耗——若末地运行缓慢，建议优先降低此值。
option.END_VORTEX_X=§4§l§f§l轴 §f§lX
option.END_VORTEX_X.comment=雾柱所在的世界 X 坐标。末地主岛生成于原点，因此设为 0 可将雾柱置于岛屿正上方。
option.END_VORTEX_Z=§4§l§f§l轴 §f§lZ
option.END_VORTEX_Z.comment=雾柱所在的世界 Z 坐标。
option.END_VORTEX_LIGHT_HEIGHT=§4§l§f§l灯光§f§l高度
option.END_VORTEX_LIGHT_HEIGHT.comment=灯光在岛屿上方的垂直高度。越高则形成更高、更宽、更平缓的锥形；越低则紧收于黑曜石柱上方。
option.END_VORTEX_RANGE=§4§l§f§l范围
option.END_VORTEX_RANGE.comment=灯光的照射范围。同时限制光线步进范围，数值越小性能消耗越低。
option.END_VORTEX_FALLOFF=§4§l§f§l边缘§f§l柔和度
option.END_VORTEX_FALLOFF.comment=雾柱渐隐柔边的宽度，以范围比例表示。较低数值会产生明显的边界感。
option.END_VORTEX_CORE=§4§l§f§l半径§f§l C
option.END_VORTEX_CORE.comment=中心轴周围浓雾的半径。越大则雾柱越分散；越小则形成更集中的光柱。
option.END_VORTEX_DENSITY=§4§l§f§l密度
option.END_VORTEX_DENSITY.comment=雾柱内部的雾气浓度。数值越高则越明亮但越扁平，因透光量减少。
option.END_VORTEX_SHADOW=§4§l§f§l阴影§f§l强度
option.END_VORTEX_SHADOW.comment=雾气自体阴影的强度。此为塑造漏斗形态的关键设置：提高数值形成锐利的锥形，降低数值则呈现无形状的均匀辉光。
option.END_VORTEX_PHASE=§4§l§f§l前向§f§l散射
option.END_VORTEX_PHASE.comment=雾气向前方散射光线的强度。数值越高则光晕越集中于灯光源周围。
option.END_VORTEX_SPIN=§4§l§f§l旋转§f§l速率
option.END_VORTEX_SPIN.comment=雾气绕轴心旋转的速度。
option.END_VORTEX_TWIST=§4§l扭§f§l曲度
option.END_VORTEX_TWIST.comment=雾气螺旋缠绕的紧密程度。0 表示呈现直射状放射纹路。
option.END_VORTEX_BRIGHTNESS=§4§l§f§l亮度
option.END_VORTEX_BRIGHTNESS.comment=相对于周围雾气的亮度比例，确保无论雾气状态如何都能保持可视范围。1.0 表示与环境雾气亮度匹配。
option.END_VORTEX_COLOR_R=§4§l§f§l红
option.END_VORTEX_COLOR_R.comment=灯光的红色分量。
option.END_VORTEX_COLOR_G=§4§l§f§l绿
option.END_VORTEX_COLOR_G.comment=灯光的绿色分量。
option.END_VORTEX_COLOR_B=§4§l§f§l蓝
option.END_VORTEX_COLOR_B.comment=灯光的蓝色分量。

screen.EndLightning=§4§l§f§l末§f§l地闪电
option.END_LIGHTNING=§4§l§f§l末§f§l地闪电
option.END_LIGHTNING.comment=风暴在岛屿周围雾气中产生的闪光。每次闪光会照亮其所在区域的雾气，因此表现为风暴内部的天气现象而非叠加的精灵特效。闪光间歇期不消耗性能。
option.END_LIGHTNING_INTERVAL=§4§l§f§l间隔
option.END_LIGHTNING_INTERVAL.comment=两次闪光触发机会之间的间隔秒数。数值越小风暴越频繁。
option.END_LIGHTNING_FREQUENCY=§4§l§f§l频率
option.END_LIGHTNING_FREQUENCY.comment=触发机会实际产生闪光的比例。较低数值会形成长而不规则的间隔，这正是营造天气感的关键。1.0 表示每次间隔必然触发，像节拍器般规律。
option.END_LIGHTNING_DECAY=§4§l§f§l衰减
option.END_LIGHTNING_DECAY.comment=闪光消失的速度。数值越高则闪光越短促；数值越低则留下持久光晕。
option.END_LIGHTNING_BRIGHTNESS=§4§l§f§l亮度
option.END_LIGHTNING_BRIGHTNESS.comment=闪光相对于周围雾气的亮度比例，确保无论雾气状态如何都能保持可视范围。
option.END_LIGHTNING_SPACING=§4§l§f§l间距
option.END_LIGHTNING_SPACING.comment=闪光分布的世界网格间距。数值越大则闪光分布越稀疏且越远。
option.END_LIGHTNING_HEIGHT=§4§l§f§l高度
option.END_LIGHTNING_HEIGHT.comment=闪光发生的位置海拔。
option.END_LIGHTNING_RANGE=§4§l§f§l范围
option.END_LIGHTNING_RANGE.comment=闪光光线在雾气中的穿透距离。同时限制闪光燃烧期间的光线步进范围，数值越小性能消耗越低。
option.END_LIGHTNING_PHASE=§4§l§f§l前向§f§l散射
option.END_LIGHTNING_PHASE.comment=闪光向前方散射的程度。较低数值会使光线在雾气中均匀扩散，适合大面积片状闪电效果。
option.END_LIGHTNING_COLOR_R=§4§l§f§l红
option.END_LIGHTNING_COLOR_R.comment=闪光的红色分量。
option.END_LIGHTNING_COLOR_G=§4§l§f§l绿
option.END_LIGHTNING_COLOR_G.comment=闪光的绿色分量。
option.END_LIGHTNING_COLOR_B=§4§l§f§l蓝
option.END_LIGHTNING_COLOR_B.comment=闪光的蓝色分量。

screen.EndVoid=§4§l§f§l发§f§l光
option.END_VOID_GLOW=§4§l§f§l发§f§l光
option.END_VOID_GLOW.comment=光线从岛屿下方的虚空中升起。在所选高度及以下区域保持全强度，从该高度向上逐渐减弱，使得虚空区域看起来包含内容而非纯黑。
option.END_VOID_ALTITUDE=§4§l§f§l海拔
option.END_VOID_ALTITUDE.comment=光辉向上衰减的起始高度。主岛屿下方的虚空区域从约-60层开始。
option.END_VOID_FALLOFF=§4§l§f§l衰减
option.END_VOID_FALLOFF.comment=光辉向上衰减的速度。较高值使光辉紧贴虚空边缘；较低值使其扩散至岛屿周围。
option.END_VOID_RANGE=§4§l§f§l范围
option.END_VOID_RANGE.comment=光线追踪距离。向下看时较低值可降低性能消耗。
option.END_VOID_DENSITY=§4§l§f§l密度
option.END_VOID_DENSITY.comment=光辉自身增加的雾量。提高此值可使虚空中既存在光照又呈现朦胧感。
option.END_VOID_BRIGHTNESS=§4§l§f§l亮度
option.END_VOID_BRIGHTNESS.comment=相对于周围雾气的亮度。
option.END_VOID_COLOR_R=§4§l§f§l红
option.END_VOID_COLOR_R.comment=光辉的红色分量。
option.END_VOID_COLOR_G=§4§l§f§l绿
option.END_VOID_COLOR_G.comment=光辉的绿色分量。
option.END_VOID_COLOR_B=§4§l§f§l蓝
option.END_VOID_COLOR_B.comment=光辉的蓝色分量。

option.DARK_END_STRENGTH=§4§l§f§l末影龙§f§l战斗变§f§l暗效果
option.DARK_END_STRENGTH.comment=末影龙战斗使末地变暗的程度。默认值为1.0，即首领栏出现瞬间末地亮度降低约375倍——维度几乎陷入黑暗。设为0则末地保持常态亮度。星空与黑洞效果均不再受影响。
option.END_VORTEX_OPACITY=§4§l不§f§l透明度
option.END_VORTEX_OPACITY.comment=光柱对后方物体的遮蔽程度。其自发光与塑造漏斗形态的自阴影不受影响。设为0时效果仅为叠加式增亮，无法产生暗部——这是默认值，因为该光柱是"超级"与"神级"预设对末地的唯一新增内容，任何遮蔽效果都会直接导致这些预设比"中等"预设更暗。仅当希望光柱真实遮挡后方物体时才需调高。
option.END_VORTEX_MIN_LIGHT=§4§l§f§l最小§f§l光照
option.END_VORTEX_MIN_LIGHT.comment=光柱的最低亮度值。其亮度通常取自周围雾气，但末地雾气可能近乎纯黑——纯相对锚点会在不发光的情况下增加厚度，反而使维度变暗。此参数为该效果的下限。若末地显得扁平死寂则需调高。
option.END_SKY_CLEARANCE=§4§l§f§l星§f§l空雾§f§l气清除
option.END_SKY_CLEARANCE.comment=末地体积雾与天空保持的距离。该雾气经40倍增益处理，会在微小变化中从清澈突变为完全不透明——当雾气触发时会逐片清除整个天空（包括星空与黑洞），这些区域会随视角转动时隐时现。地形雾不受影响。若希望雾气重新覆盖天空则降低此值；0为默认行为。
option.END_BLACK_SKY=§4§l§f§l夜§f§l空
option.END_BLACK_SKY.comment=将末地温暖的橄榄色背景替换为近纯黑夜空。仅影响末地。
option.END_SKY_BRIGHTNESS=§4§l§f§l天§f§l空亮度
option.END_SKY_BRIGHTNESS.comment=星空背景的整体亮度等级。0为纯黑色。
option.END_SKY_COLOR_R=§4§l§f§l红
option.END_SKY_COLOR_R.comment=背景的红色分量。
option.END_SKY_COLOR_G=§4§l§f§l绿
option.END_SKY_COLOR_G.comment=背景的绿色分量。
option.END_SKY_COLOR_B=§4§l§f§l蓝
option.END_SKY_COLOR_B.comment=背景的蓝色分量。
option.END_STARS_ALL_SKY=§4§l§f§l遍布§f§l星空
option.END_STARS_ALL_SKY.comment=在整个球面填充星星。关闭时保留默认衰减效果，使星星向地平线方向逐渐隐去。
option.END_STARS_COVERAGE=§4§l§f§l星星§f§l数量
option.END_STARS_COVERAGE.comment=相对于默认数量的星星密度。
option.END_STARS_BRIGHTNESS=§4§l§f§l星§f§l星亮度
option.END_STARS_BRIGHTNESS.comment=星星的燃烧亮度。
option.END_STARS_SCALE=§4§l§f§l星星§f§l缩放
option.END_STARS_SCALE.comment=星星所依附的网格尺寸。较高值会生成更小、更密集的星星。

## End Nebula + End Stone (added) ##
screen.Nebula=§4§l§f§l星云
screen.EndStone=§4§l石§f§l质参数（e§f§l stone）

option.END_NEBULA=§4§l§f§l星云启§f§l用状态
option.END_NEBULA.comment=跨越末地天空的程序化深空星云——呈现为带明亮青柠色内核与温暖金色薄雾的翠绿色翻腾云团，凝聚为几处质量体，其间分布着仅含星光的开阔天区。沿视线方向进行真三维噪声采样，因此无极地接缝，且在各方向均自然呈现。位于星空与黑洞后方。
option.END_NEBULA_BRIGHTNESS=§4§l§f§l亮度
option.END_NEBULA_BRIGHTNESS.comment=星云云团的整体亮度。
option.END_NEBULA_DENSITY=§4§l§f§l覆盖范围
option.END_NEBULA_DENSITY.comment=云团覆盖天空的范围。较高值降低密度阈值，使其在球面上扩散更远；较低值使其收缩为更紧凑、孤立的质量体。
option.END_NEBULA_SCALE=§4§l云§f§l团结构尺寸（fture§f§l scale）
option.END_NEBULA_SCALE.comment=云团结构的尺寸。较低值生成更大、更舒展的云团；较高值生成更小、更繁复的细节。
option.END_NEBULA_GREEN_R=§4§l绿§f§l色分量（g r§f§l）
option.END_NEBULA_GREEN_R.comment=在绿色云层上的红色色调。中性（1,1,1）保留参考绿色。
option.END_NEBULA_GREEN_G=§4§l§f§lg g§f§l
option.END_NEBULA_GREEN_G.comment=在绿色云层上的绿色色调。
option.END_NEBULA_GREEN_B=§4§l§f§lg b§f§l
option.END_NEBULA_GREEN_B.comment=在绿色云层上的蓝色色调。
option.END_NEBULA_WARM_R=§4§l§f§lw §f§lr
option.END_NEBULA_WARM_R.comment=在云层中交织的暖金色薄雾上的红色色调。
option.END_NEBULA_WARM_G=§4§l§f§lw §f§lg
option.END_NEBULA_WARM_G.comment=在暖金色薄雾上的绿色色调。
option.END_NEBULA_WARM_B=§4§l§f§lw §f§lb
option.END_NEBULA_WARM_B.comment=在暖金色薄雾上的蓝色色调。

option.END_STONE_RETEXTURE=§4§l§f§l末§f§l地石§f§l纹理
option.END_STONE_RETEXTURE.comment=用程序生成的编织砖米色图案重新绘制末地石，以替代原版的平面纹理。纯粹是反照率变化，与末地石方块ID绑定。需要资源包附带的 block.properties 文件中的 block.10059 条目。
