value.SHADER_SUN_MOON_SHAPE.1=方形

option.SHADER_SUN_MOON_SIZE=太阳与月亮尺寸 
option.SHADER_SUN_MOON_SIZE.comment=天空中太阳和月亮圆盘的缩放比例。
value.SHADER_SUN_MOON_SIZE.0.25=微型
value.SHADER_SUN_MOON_SIZE.0.50=小
