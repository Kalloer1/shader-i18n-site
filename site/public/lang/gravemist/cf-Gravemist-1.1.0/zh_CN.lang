value.GM_BLOOD_MOON_MODE.4=每夜

value.GM_ECLIPSE_MODE.0=从不
value.GM_ECLIPSE_MODE.1=稀有
value.GM_ECLIPSE_MODE.2=§e每天

value.GM_CLOUD_STYLE.0=关
value.GM_CLOUD_STYLE.1=原版
value.GM_CLOUD_STYLE.2=程序化

