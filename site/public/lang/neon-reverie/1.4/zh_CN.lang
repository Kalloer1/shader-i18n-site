value.DIRECTIONAL_BLOCKLIGHT.3=微弱 §c[-]
value.DIRECTIONAL_BLOCKLIGHT.7=普通 §c[-]
value.DIRECTIONAL_BLOCKLIGHT.11=强烈 §c[-]

option.HELD_LIGHTING_MODE=动态手持照明
option.HELD_LIGHTING_MODE.comment=允许手持光源向场景投射光线。
value.HELD_LIGHTING_MODE.0=关
value.HELD_LIGHTING_MODE.1=微弱
value.HELD_LIGHTING_MODE.2=正常

option.BLOCKLIGHT_FLICKERING=方块光闪烁
option.BLOCKLIGHT_FLICKERING.comment=为方块发出的光添加闪烁效果。
value.BLOCKLIGHT_FLICKERING.0=关闭

option.WAVING_SPEED=摆动速度
option.WAVING_SPEED.comment=调整摆动效果的速度。

option.WAVING_I=摆动强度
option.WAVING_I.comment=调整方块摆动时的幅度。§c[-]§r 摆动强度过高会导致摆动方块与其他方块发生穿模。
value.WAVING_I.1.25=1.25 §c[-]
value.WAVING_I.1.50=1.50 §c[-]
value.WAVING_I.1.75=1.75 §c[-]
value.WAVING_I.2.00=2.00 §c[-]
value.WAVING_I.50.0=§c疯狂

option.NO_WAVING_INDOORS=封闭区域不摆动
option.NO_WAVING_INDOORS.comment=防止方块在利用天光的封闭区域中摆动。§c[-]§r 启用此设置可能会导致某些资源包或模组出现问题。

option.WAVING_I_RAIN_MULT=§e雨水摇曳倍数§r
option.WAVING_I_RAIN_MULT.comment=乘以雨水期间摇曳的速度和强度。§c[-]§r过高的摇曳强度会导致摇曳方块穿模进其他方块。§c[-]§r将此设置提高到100以上会影响性能。
value.WAVING_I.125=125 §c[-]
value.WAVING_I.150=150 §c[-]
value.WAVING_I.175=175 §c[-]
value.WAVING_I.200=200 §c[-]

option.WAVING_FOLIAGE=摇曳的草
option.WAVING_FOLIAGE.comment=为草和其他类似植物添加摆动以模拟风。

option.WAVING_LEAVES=树叶摇曳
option.WAVING_LEAVES.comment=为树叶添加运动以模拟风。

option.WAVING_LAVA=摇曳的岩浆纹理
option.WAVING_LAVA.comment=为岩浆添加持续的运动。§e[*]§r特别是岩浆的摇曳不受“封闭区域不摇曳”设置的影响。

option.WAVING_LILY_PAD=摇曳睡莲 §c[-]§r
option.WAVING_LILY_PAD.comment=为睡莲和蛙卵添加运动效果，以模拟水波的冲击。§c[-]§r 这会导致水浸方块上的睡莲变得不可见

option.WAVING_WATER_VERTEX=波动水面高度
option.WAVING_WATER_VERTEX.comment=为水面位置添加移动以模拟风。§e[*]§r 此选项与“水面波浪强度”设置无关。

option.WAVING_RAIN=摇曳的雨/雪纹理
option.WAVING_RAIN.comment=为下落的雨和雪纹理添加运动效果，使其看起来更具动态感。

option.SPECIAL_PORTAL_EFFECTS=特殊传送门效果
option.SPECIAL_PORTAL_EFFECTS.comment=为下界传送门、末地传送门和末地折跃门添加特殊动画与自发光效果。

option.REFLECTION_RES=§e反射分辨率§r
option.REFLECTION_RES.comment=更改方块上 PBR 反射的分辨率（以及如果启用了该设置的世界空间反射），以提升性能。§c[-]§r “完整”分辨率反射在某些情况下对性能的影响可能远超预期。§e[*]§r 此功能在 OptiFine 上无法运行。
value.REFLECTION_RES.1.0=§4§l§n§o完整
value.REFLECTION_RES.0.5=§a半

option.WORLD_OUTLINE=§e世界轮廓§r
option.WORLD_OUTLINE.comment=为方块添加明亮的轮廓。§c[-]§r此效果可能会影响性能。

option.WORLD_OUTLINE_THICKNESS=§e世界轮廓厚度§r
option.WORLD_OUTLINE_THICKNESS.comment=决定世界轮廓效果的厚度。§c[-]§r提高此设置可能会影响性能。

option.WORLD_OUTLINE_I=世界轮廓亮度
option.WORLD_OUTLINE_I.comment=决定世界轮廓效果的强度。

option.WORLD_OUTLINE_ON_ENTITIES=世界轮廓（实体）
option.WORLD_OUTLINE_ON_ENTITIES.comment=确定世界轮廓效果是否应用于实体。§c[-]§r 此设置可能无法与某些自定义 PBR 资源包完美兼容。

option.WORLD_OUTLINE_SCALED=距离缩放世界轮廓
option.WORLD_OUTLINE_SCALED.comment=使世界轮廓的大小根据距离进行缩放。

option.DARK_OUTLINE=§e暗色轮廓§r
option.DARK_OUTLINE.comment=为方块添加暗色轮廓。§c[-]§r 此效果可能会影响性能。

option.DARK_OUTLINE_THICKNESS=§e暗边厚度§r
option.DARK_OUTLINE_THICKNESS.comment=决定暗边效果的厚度。§c[-]§r提高此设置可能会影响性能。

option.RAIN_PUDDLES=§e雨坑§r
option.RAIN_PUDDLES.comment=在雨天为地形添加水坑。§c[-]§r 雨坑会严重影响性能。
value.RAIN_PUDDLES.0=§a关
value.RAIN_PUDDLES.1=§c雨天水坑
value.RAIN_PUDDLES.2=§c雨天全覆盖
value.RAIN_PUDDLES.3=§c常驻水坑
value.RAIN_PUDDLES.4=§c常驻全覆盖

option.UNDERWATER_DISTORTION=水下畸变
option.UNDERWATER_DISTORTION.comment=当相机在水中时，为屏幕添加微妙的折射效果。

option.SELECT_OUTLINE=选择框线
option.SELECT_OUTLINE.comment=决定方块选择框线的颜色。
value.SELECT_OUTLINE.0=关闭
value.SELECT_OUTLINE.1=默认
value.SELECT_OUTLINE.2=彩虹
value.SELECT_OUTLINE.3=选择颜色
value.SELECT_OUTLINE.4=多样化

option.SELECT_OUTLINE_AUTO_HIDE=自动隐藏选择框
option.SELECT_OUTLINE_AUTO_HIDE.comment=当玩家主手空置时，隐藏方块选择轮廓。

option.SELECT_OUTLINE_I=SO 亮度
option.SELECT_OUTLINE_R=SO 红色
option.SELECT_OUTLINE_G=SO 绿色
option.SELECT_OUTLINE_B=SO 蓝色

option.MOON_PHASE_INF_LIGHT=月相夜间光照
option.MOON_PHASE_INF_LIGHT.comment=启用不同的月相来改变夜间光照的亮度。

option.MOON_PHASE_INF_ATMOSPHERE=月相夜间氛围
option.MOON_PHASE_INF_ATMOSPHERE.comment=启用不同的月相来改变夜间氛围的亮度。

option.MOON_PHASE_INF_REFLECTION=月相月亮倒影
option.MOON_PHASE_INF_REFLECTION.comment=启用不同的月相来改变月亮倒影的亮度。

option.MOON_PHASE_FULL=满月强度
option.MOON_PHASE_FULL.comment=调整满月阶段（最亮阶段）的月相影响。

option.MOON_PHASE_PARTIAL=部分月光强度
option.MOON_PHASE_PARTIAL.comment=调整满月与暗月之间所有月相的月光影响。这是你在Minecraft中最常看到的月相。

option.MOON_PHASE_DARK=暗月强度
option.MOON_PHASE_DARK.comment=调整新月（最暗阶段）期间的月亮相位影响。

option.CONNECTED_GLASS_EFFECT=连接玻璃
option.CONNECTED_GLASS_EFFECT.comment=让所有类型的玻璃相互连接。§e[*]§r此功能仅在性能设置中开启高级彩色追踪且你的系统支持时才能生效。§e[*]§r如果安装了"Continuity"模组，此功能将自动禁用。

option.PORTAL_EDGE_EFFECT=传送门边缘发光
option.PORTAL_EDGE_EFFECT.comment=为末影和地狱传送门添加自发光边框效果。§e[*]§r此功能仅在性能设置中开启 Advanced Color Tracing 且你的系统支持时才能生效。

option.PUDDLE_VOXELIZATION=修复玻璃下的水坑
option.PUDDLE_VOXELIZATION.comment=当启用“雨水水坑”设置时，防止在有玻璃屋顶的封闭区域内形成雨水水坑。§e[*]§r此功能仅在启用高级色彩追踪且细节质量设置为高配或以上时生效。

option.COLORED_CANDLE_LIGHT=彩色蜡烛光照
option.COLORED_CANDLE_LIGHT.comment=使蜡烛发出的光与其底座颜色一致。§e[*]§r脱饱和的蜡烛颜色变体将继续使用普通的火焰颜色。

option.COLORED_LIGHT_SATURATION=彩色光照饱和度
option.COLORED_LIGHT_SATURATION.comment=调整高级色彩追踪产生的颜色的饱和度。§e[*]§r不建议更改此数值，因为视觉效果在默认饱和度下设计得最为平衡。

option.COLORED_LIGHT_FOG=§e彩色光雾§r
option.COLORED_LIGHT_FOG.comment=为场景添加体积方块光雾，在夜间或地下最为明显。§e[*]§r 此功能仅在性能设置中开启高级颜色追踪且你的系统支持时才能生效。§c[-]§r 此效果会严重影响性能。

option.COLORED_LIGHT_FOG_I=彩色光雾强度
option.COLORED_LIGHT_FOG_I.comment=决定彩色光雾的亮度。

option.LIGHT_COLOR_MULTS=§e光照颜色乘数
option.LIGHT_COLOR_MULTS.comment=允许自定义在所有表面看到的光照颜色。

option.ATM_COLOR_MULTS=§e大气颜色乘数
option.ATM_COLOR_MULTS.comment=启用自定义主要在天空和雾中显示的大气颜色。

