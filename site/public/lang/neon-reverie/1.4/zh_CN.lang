#Settings
option.RP_MODE=RP 支持
option.RP_MODE.comment=更改许多内部计算，以确定不同方块和材质的渲染方式。§bIntegrated PBR+§r：计算出的 PBR 和额外效果，大多数情况强烈推荐。§a基础§r：无 PBR 或额外效果。§e自定义 PBR§r：使用兼容 PBR 资源包的材质。
value.RP_MODE.0=§a基础
value.RP_MODE.1=§bIntegrated PBR+
value.RP_MODE.2=§e高光 PBR (需要资源包)
value.RP_MODE.3=§elabPBR (需要资源包)

option.WATER_REFLECT_QUALITY=水反射质量
option.WATER_REFLECT_QUALITY.comment=调整出现在半透明方块上的反射的视觉质量。§cMedium§r：水和半透明方块上的屏幕空间光线追踪反射。§ePotato§r：用更快的方法替换水和半透明反射，在某些情况下可能看起来不正确。§aOFF§r：无反射。
value.WATER_REFLECT_QUALITY.-1=§aOFF
value.WATER_REFLECT_QUALITY.0=§a仅天空
value.WATER_REFLECT_QUALITY.1=§ePotato
value.WATER_REFLECT_QUALITY.2=§c中等

option.BLOCK_REFLECT_QUALITY=方块反射质量 §e[*]§r
option.BLOCK_REFLECT_QUALITY.comment=调整固体材料上出现的反射的视觉质量。§c高配§r：太阳/月亮高光 + 高级镜面反射。§e低配§r：仅太阳/月亮高光。§e[*]§r 资源包支持选项必须设置为除 Basic 以外的任何选项，才能出现镜面反射。
value.BLOCK_REFLECT_QUALITY.0=§a关闭
value.BLOCK_REFLECT_QUALITY.1=§e低配
value.BLOCK_REFLECT_QUALITY.3=§c高配

option.SHADOW_QUALITY=实时阴影
option.SHADOW_QUALITY.comment=调整阴影的质量。每一档都能进一步减少阴影噪点，§e低§r和§e极低§r使用更简单的阴影过滤，§e极低§r还会禁用彩色阴影，§a关闭§r会完全禁用阴影和体积光。§e[*]§r 如果你禁用时间过滤器或启用像素化阴影设置，此设置内部会被限制在"低"。
value.SHADOW_QUALITY.-1=§a关闭
value.SHADOW_QUALITY.0=§e极低
value.SHADOW_QUALITY.1=§e低
value.SHADOW_QUALITY.2=§e中
value.SHADOW_QUALITY.3=§c高
value.SHADOW_QUALITY.4=§c极高
value.SHADOW_QUALITY.5=§4§l超绝

option.LIGHTSHAFT_QUALI_DEFINE=体积光质量 §e[*]§r
option.LIGHTSHAFT_QUALI_DEFINE.comment=调整体积光的质量。每一档都能进一步减少噪点伪影。§e[*]§r "Real-Time Shadows"设置必须设置为非OFF，体积光才能生效。§e[*]§r 此设置还控制末影光束的质量，但"OFF"选项会被视为"低配"。
value.LIGHTSHAFT_QUALI_DEFINE.0=§a关闭
value.LIGHTSHAFT_QUALI_DEFINE.1=§e低配
value.LIGHTSHAFT_QUALI_DEFINE.2=§e中配
value.LIGHTSHAFT_QUALI_DEFINE.3=§c高配
value.LIGHTSHAFT_QUALI_DEFINE.4=§4§l极高

option.shadowDistance=阴影距离
option.shadowDistance.comment=调整玩家渲染实时阴影的距离。§c[-]§r 较低的值可能导致过度的体积光泄漏。
value.shadowDistance.64.0=§a4 区块 §c[-]
value.shadowDistance.80.0=§a5 区块 §c[-]
value.shadowDistance.96.0=§a6 区块 §c[-]
value.shadowDistance.112.0=§a7 区块 §c[-]
value.shadowDistance.128.0=§a8 区块
value.shadowDistance.160.0=§e10 区块
value.shadowDistance.192.0=§e12 区块
value.shadowDistance.224.0=§e14 区块
value.shadowDistance.256.0=§c16 区块
value.shadowDistance.320.0=§c20 区块
value.shadowDistance.384.0=§4§l24 区块
value.shadowDistance.512.0=§4§l32 区块
value.shadowDistance.768.0=§4§l§n§o48 区块
value.shadowDistance.1024.0=§4§k-§r§4§l§n§o64 区块§r§4§k-

option.ENTITY_SHADOW=实体阴影
option.ENTITY_SHADOW.comment=启用实体与方块实体投射的阴影。"普通实体"包括动物和怪物等，而"完整"选项还包括箱子等方块实体。§c[-]§r实体阴影对性能的影响远超预期，在某些情况下会损失超过50%的帧数。
value.ENTITY_SHADOW.-1=§a关闭
value.ENTITY_SHADOW.1=§c普通实体
value.ENTITY_SHADOW.2=§4§k-§r§4§l§n§oFull§r§4§k- §r§c[-]

option.DETAIL_QUALITY=细节质量
option.DETAIL_QUALITY.comment=调整若干影响性能的小细节。调整以下项目的质量：水材质、TAA、光照微调、夜星云、下界风暴、天空效果反射、雨坑精度、摆动效果、运动模糊
value.DETAIL_QUALITY.0=§a土豆
value.DETAIL_QUALITY.2=§e中配
value.DETAIL_QUALITY.3=§c高配

option.CLOUD_QUALITY=云质量
option.CLOUD_QUALITY.comment=调整 Rounded/Volumetric 云风格的照明、细节和采样质量。§e[*]§r 此设置仅适用于 "Rounded" 或 "Volumetric" 云风格。
value.CLOUD_QUALITY.0=§a关闭
value.CLOUD_QUALITY.1=§a低配
value.CLOUD_QUALITY.2=§e中配
value.CLOUD_QUALITY.3=§c高配

option.FXAA_DEFINE=抗锯齿 (FXAA)
option.FXAA_DEFINE.comment=启用快速近似抗锯齿（FXAA），这基本上是一种使图像更平滑的效果。
value.FXAA_DEFINE.-1=§a关
value.FXAA_DEFINE.1=§e开

option.SSAO_QUALI_DEFINE=边缘阴影 (SSAO) 质量
option.SSAO_QUALI_DEFINE.comment=调整屏幕空间环境光遮蔽 (SSAO) 的质量，为场景边缘添加额外的环境阴影。每个更高等级都会进一步减少 SSAO 的噪声瑕疵。
value.SSAO_QUALI_DEFINE.0=§aOFF
value.SSAO_QUALI_DEFINE.2=§e中配
value.SSAO_QUALI_DEFINE.3=§c高配

option.ANISOTROPIC_FILTER=纹理过滤
option.ANISOTROPIC_FILTER.comment=使用各向异性过滤提升mipmap纹理的质量。§e[*]§r 请确保你的"Mipmap Levels"视频设置已设为最高（4），否则无法获得良好效果。
value.ANISOTROPIC_FILTER.0=§a关闭
value.ANISOTROPIC_FILTER.4=§e4x
value.ANISOTROPIC_FILTER.8=§e8x
value.ANISOTROPIC_FILTER.16=§4§l16x

option.COLORED_LIGHTING=高级颜色追踪 §e[*]§r
option.COLORED_LIGHTING.comment=使用体素化和泛洪填充光照为方块光添加颜色，并引入一些新光源。§e[*]§r 此功能仅在 Iris 和受支持的平台上可用。§e[*]§r 如果“实时阴影”关闭，此设置将被禁用。§a[+]§r 高级颜色追踪系统还启用了一些其他功能，您可以在“其他” -> “ACT 功能”菜单中单独启用/禁用它们。§c[-]§r 此效果的高区块值对性能的影响远超预期，每增加一档所需的性能可能是上一档的两倍以上。§c[-]§r 在处理非完整方块或模组方块时，彩色光照可能会产生一些光漏问题。
value.COLORED_LIGHTING.0=§a关闭
value.COLORED_LIGHTING.128=§c4 区块
value.COLORED_LIGHTING.192=§c6 区块
value.COLORED_LIGHTING.256=§4§l8 区块
value.COLORED_LIGHTING.384=§4§l12 区块
value.COLORED_LIGHTING.512=§4§l§n§o16 区块
value.COLORED_LIGHTING.768=§4§l§n§o24 区块 §r§c[-]
value.COLORED_LIGHTING.1024=§4§k-§r§4§l§n§o32 区块§r§4§k- §r§c[-]

option.WORLD_SPACE_REFLECTIONS=世界空间反射 §e[*]§r
option.WORLD_SPACE_REFLECTIONS.comment=在世界空间而非屏幕空间计算反射。§e[*]§r 此功能仅在性能设置中开启高级彩色追踪且您的系统支持时才能生效。§e[*]§r 此效果的最大距离取决于高级彩色追踪的距离，但由于技术原因，内部上限为16区块。§c[-]§r 此效果会严重影响性能，尤其是当高级彩色追踪距离较高时。§c[-]§r 世界空间反射可能会与模组或资源包产生多种兼容性问题。
value.WORLD_SPACE_REFLECTIONS.-1=§a关闭
value.WORLD_SPACE_REFLECTIONS.1=§4§l§n§o开启

option.WORLD_SPACE_REF_MODE=WSR 模式 §e[*]§r
option.WORLD_SPACE_REF_MODE.comment=决定世界空间反射的运行模式。§e[*]§r“仅 WSR”模式通过仅显示世界空间反射来消除所有屏幕空间反射伪影，而“WSR + SSR”模式则能获取反射中更多的总细节，因为屏幕空间反射可以访问屏幕上的所有细节，而不受方块或设定距离的限制。
value.WORLD_SPACE_REF_MODE.1=仅 WSR
value.WORLD_SPACE_REF_MODE.2=WSR + SSR

option.WORLD_SPACE_PLAYER_REF=WS 玩家反射
option.WORLD_SPACE_PLAYER_REF.comment=使当前玩家自身的玩家模型在世界空间反射中反射。
value.WORLD_SPACE_PLAYER_REF.-1=关闭
value.WORLD_SPACE_PLAYER_REF.1=开启

option.SSAO_I=边缘阴影强度 (SSAO)
option.SSAO_I.comment=决定屏幕空间环境光遮蔽（SSAO）的强度，即为场景边缘添加额外的环境阴影。§e[*]§r 如果在“性能设置”中禁用了 SSAO，此设置将无效。
value.SSAO_I.0=OFF

option.VANILLAAO_I=边缘阴影强度 (原版)
option.VANILLAAO_I.comment=决定Minecraft环境光遮蔽的强度，该效果会为场景边缘添加额外的环境阴影。
value.VANILLAAO_I.0=关闭

option.BORDER_FOG=边界雾
option.BORDER_FOG.comment=已加载世界边缘的浓雾，用于隐藏区块边界。§e[*]§r 建议在渲染距离小于8个区块时禁用边界雾。

option.ATM_FOG_MULT=大气雾
option.ATM_FOG_MULT.comment=调整基于海拔的雾的强度。
value.ATM_FOG_MULT.0.50=极细微
value.ATM_FOG_MULT.0.65=细微
value.ATM_FOG_MULT.0.80=普通
value.ATM_FOG_MULT.0.95=强烈

option.ATM_FOG_DISTANCE=大气雾距离
option.ATM_FOG_DISTANCE.comment=调整大气雾开始出现的距离（相对于相机）。§e[*]§r 注意，雾距离也会由视频设置中的渲染距离设置自动调整。

option.ATM_FOG_ALTITUDE=大气雾高度
option.ATM_FOG_ALTITUDE.comment=决定大气雾最显著出现的高度。

option.CAVE_FOG=洞穴雾
option.CAVE_FOG.comment=在深层地下区域启用额外的雾。

option.LIGHTSHAFT_BEHAVIOUR=体积光模式
option.LIGHTSHAFT_BEHAVIOUR.comment=决定体积光的行为。§a[+]§r 场景感知体积光会在普通与极限模式间自动切换，以提供最佳效果。§c[-]§r 极限模式不建议用于一般游戏游玩，且会严重影响性能。
value.LIGHTSHAFT_BEHAVIOUR.0=关闭
value.LIGHTSHAFT_BEHAVIOUR.1=场景感知 §a[+]
value.LIGHTSHAFT_BEHAVIOUR.2=普通
value.LIGHTSHAFT_BEHAVIOUR.3=极限 §c[-]

option.LIGHTSHAFT_SMOKE=§e体积光烟雾§r
option.LIGHTSHAFT_SMOKE.comment=为体积光添加烟雾。§c[-]§r此效果会严重影响性能。

option.SPECIAL_PALE_GARDEN_LIGHTSHAFTS=特殊苍白花园体积光
option.SPECIAL_PALE_GARDEN_LIGHTSHAFTS.comment=使体积光在“苍白花园”群系中看起来更加浓郁。

option.LIGHTSHAFT_DAY_I=体积光 日间倍率
option.LIGHTSHAFT_NIGHT_I=体积光 夜间倍率
option.LIGHTSHAFT_RAIN_I=体积光 雨天倍率

option.LIGHTSHAFT_SUNSET_SATURATION=体积光日落颜色
