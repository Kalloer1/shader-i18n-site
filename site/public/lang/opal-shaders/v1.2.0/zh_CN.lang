#Settings
option.ABOUT=OPAL Shaders v1.2.0
option.ABOUT.comment=基于 Capt Tatsu 的 BSL Shaders。bitslablab.com
value.ABOUT.0=由 FENVEN 制作

#Lighting
option.shadowMapResolution=阴影贴图质量
option.shadowMapResolution.comment=调整阴影贴图大小。§e[*]§r更高分辨率产生更清晰的阴影，但会降低性能。
value.shadowMapResolution.512=极低 (512)
value.shadowMapResolution.1024=低 (1024)
value.shadowMapResolution.2048=中 (2048)
value.shadowMapResolution.3072=高 (3072)
value.shadowMapResolution.4096=极高 (4096)
value.shadowMapResolution.8192=超高 (8192)

option.shadowDistance=阴影距离
option.shadowDIstance.comment=调整阴影距离。

option.SHADOW_CLOUD=云层阴影
option.SHADOW_CLOUD.comment=启用云层阴影。

option.SHADOW_COLOR=彩色阴影
option.SHADOW_COLOR.comment=启用半透明物体的彩色阴影。§a[+]§r用于彩色体积光线。§c[-]§r使用阴影滤镜时性能开销略高。

option.SHADOW_COLOR_CI=半透明阴影颜色强度
option.SHADOW_COLOR_CI.comment=调整彩色玻璃和冰的着色阴影的颜色强度。
value.SHADOW_COLOR_CI.0=低
value.SHADOW_COLOR_CI.1=中
value.SHADOW_COLOR_CI.2=高
value.SHADOW_COLOR_CI.3=极高

option.SHADOW_COLOR_CI_DT=密集半透明阴影颜色强度
option.SHADOW_COLOR_CI_DT.comment=调整粘液块和蜂蜜块的着色阴影的颜色强度。
value.SHADOW_COLOR_CI_DT.0=低配
value.SHADOW_COLOR_CI_DT.1=中配
value.SHADOW_COLOR_CI_DT.2=高配

option.SHADOW_COLOR_CI_NP=下界之门阴影颜色强度
option.SHADOW_COLOR_CI_NP.comment=调整下界之门着色阴影的颜色强度。
value.SHADOW_COLOR_CI_NP.0=低
value.SHADOW_COLOR_CI_NP.1=中
value.SHADOW_COLOR_CI_NP.2=高

option.WATER_SHADOW_COLOR=水面彩色阴影
option.WATER_SHADOW_COLOR.comment=决定水是否应投射彩色阴影以进行着色。§e[*]§r启用此功能将防止透明物体在水下时投射彩色阴影。

option.WATER_SHADOW_COLOR_CI=水影颜色强度
option.WATER_SHADOW_COLOR_CI.comment=调整水体着色阴影的颜色强度。
value.WATER_SHADOW_COLOR_CI.0=低配
value.WATER_SHADOW_COLOR_CI.1=中配
value.WATER_SHADOW_COLOR_CI.2=高配

option.SHADOW_FILTER=阴影滤波
option.SHADOW_FILTER.comment=启用阴影滤波。§a[+]§r此效果受益于 TAA.

option.sunPathRotation=太阳路径旋转
option.sunPathRotation.comment=调整太阳角度。

option.SHADOW_SUBSURFACE=次表面散射
option.SHADOW_SUBSURFACE.comment=允许光线穿透并散射穿过植被。

option.SHADOW_PIXEL=像素锁定阴影
option.SHADOW_PIXEL.comment=应用像素化效果于阴影。
value.SHADOW_PIXEL.0=关闭

option.WEATHER_SHADOW_SOFTNESS=天气阴影柔和度
option.WEATHER_SHADOW_SOFTNESS.comment=调整雨天阴影的柔和度

option.END_SHADOW_SOFTNESS=末地阴影柔和度
option.END_SHADOW_SOFTNESS.comment=调整末地阴影的柔和度。

option.VANILLA_SIDE_SHADING_I=原版侧面阴影强度
option.VANILLA_SIDE_SHADING_I.comment=调整原版方块和实体的侧面阴影强度。

option.VANILLA_CORNER_SHADING_I=原版角落阴影强度
option.VANILLA_CORNER_SHADING_I.comment=调整原版方块接缝处角落的阴影强度。

option.MOON_PHASES=月相
option.FULL_MOON_I_MULTIPLIER=满月亮度
option.GIBBOUS_I_MULTIPLIER=盈凸亮度
option.QUARTER_I_MULTIPLIER=四分之一月亮度
option.CRESCENT_I_MULTIPLIER=新月亮度
option.NEW_MOON_I_MULTIPLIER=无月亮度

option.AO=环境光遮蔽
option.AO.comment=在表面接触或交汇处添加柔和阴影。

option.AO_STRENGTH=环境光遮蔽强度
option.AO_STRENGTH.comment=调整环境光遮蔽强度。

option.DESATURATION=去饱和
option.DESATURATION.comment=降低饱和度，同时在较暗区域添加一些色调。

option.DESATURATION_FACTOR=最大去饱和因子
option.DESATURATION_FACTOR.comment=调整应用的最大去饱和程度。
value.DESATURATION_FACTOR.2.0=极低
value.DESATURATION_FACTOR.1.5=低
value.DESATURATION_FACTOR.1.0=中
value.DESATURATION_FACTOR.0.5=高
value.DESATURATION_FACTOR.0.0=极高

option.TOON_LIGHTMAP=卡通光照贴图
option.TOON_LIGHTMAP.comment=降低原版光照质量，用于卡通渲染。§e[*]§r此选项会使游戏画面质量下降，只有在需要时才启用。

option.WHITE_WORLD=白色世界
option.WHITE_WORLD.comment=将纹理替换为扁平白色

#Material
option.ADVANCED_MATERIALS=高级材质
option.ADVANCED_MATERIALS.comment=启用高光和法线贴图，可使多种物品更精细。  §e[*]§r此选项需要一个包含高光和/或法线贴图的资源包，如果您没有使用资源包，请禁用此选项。

option.MATERIAL_FORMAT=材质格式
option.MATERIAL_FORMAT.comment=决定资源包使用的法线贴图和镜面高光格式。 §e[*]§r材质艺术家通常会在资源包中说明使用的格式，使用错误的格式可能会导致奇怪的结果。
value.MATERIAL_FORMAT.0=SEUS PBR
value.MATERIAL_FORMAT.1=labPBR 1.3

option.REFRACTION=折射
option.REFRACTION.comment=启用法线贴图透明表面后方的畸变效果。 §c[-]§r透明表面本身也会发生畸变。 §c[-]§r启用此效果时，其他功能可能无法正常工作。
value.REFRACTION.0=关闭
value.REFRACTION.1=仅水面
value.REFRACTION.2=全部

#Reflections
option.REFLECTION=反射
option.REFLECTION.comment=启用屏幕空间反射. §e[*]§r此开关仅影响水和半透明反射，雨和镜面反射不受影响。

option.REFLECTION_TRANSLUCENT=半透明反射
option.REFLECTION_TRANSLUCENT.comment=允许在半透明表面（如彩色玻璃、冰、粘液块等）上渲染反射效果。

option.REFLECTION_I=反射强度
option.REFLECTION_I.comment=调整反射强度。

option.REDUCE_SKY_REFLECTIONS_BELOW_SEA_LEVEL=降低海平面以下的天空反射
option.REDUCE_SKY_REFLECTIONS_BELOW_SEA_LEVEL.comment=逐渐降低海平面以下的天空反射（Y62）

option.REFLECTION_SPECULAR=镜面反射
option.REFLECTION_SPECULAR.comment=启用光滑或金属表面的反射效果。

option.REFLECTION_RAIN=雨面反射
option.REFLECTION_RAIN.comment=允许表面在雨中变湿。  §e[*]§r需要高光反射。
value.REFLECTION_RAIN.0=关闭
value.REFLECTION_RAIN.1=水坑
value.REFLECTION_RAIN.2=完全

option.REFLECTION_ROUGH=粗糙反射
option.REFLECTION_ROUGH.comment=允许将低光滑度表面渲染为模糊反射。§c[-]§r可能包含少量瑕疵。

option.REFLECTION_PREVIOUS=上一帧反射
option.REFLECTION_PREVIOUS.comment=允许使用上一帧信息使半透明物体产生反射。§c[-]§r可能导致截图时反射缺失（由截图尺寸设置引起）。§c[-]§r与某些显卡不兼容。

option.ALBEDO_METAL=阿尔贝多 调色 硬编码金属
option.ALBEDO_METAL.comment=将基础纹理作为色调应用于硬编码金属表面。§e[*]§r仅适用于 labPBR 材质格式。

#Parallax
option.PARALLAX=视差遮蔽贴图
option.PARALLAX.comment=使用高度贴图对表面进行位移效果

option.PARALLAX_DEPTH=视差深度
option.PARALLAX_DEPTH.comment=调整视差深度。
value.PARALLAX_DEPTH.0.05=5 厘米
value.PARALLAX_DEPTH.0.10=10 厘米
value.PARALLAX_DEPTH.0.15=15 厘米
value.PARALLAX_DEPTH.0.20=20 厘米
value.PARALLAX_DEPTH.0.25=25 厘米
value.PARALLAX_DEPTH.0.30=30 厘米
value.PARALLAX_DEPTH.0.35=35 厘米
value.PARALLAX_DEPTH.0.40=40 厘米
value.PARALLAX_DEPTH.0.45=45 厘米
value.PARALLAX_DEPTH.0.50=50 厘米

option.SELF_SHADOW=自阴影
option.SELF_SHADOW.comment=允许表面使用高度贴图投射到自身阴影。

option.SELF_SHADOW_ANGLE=自阴影角度
option.SELF_SHADOW_ANGLE.comment=调整自阴影角度，数值越高阴影延伸越远。

option.PARALLAX_QUALITY=视差质量
option.PARALLAX_QUALITY.comment=调整视差遮蔽贴图和自阴影的质量。

option.PARALLAX_DISTANCE=视差距离
option.PARALLAX_DISTANCE.comment=调整视差遮蔽贴图和自阴影的渲染距离。

option.DIRECTIONAL_LIGHTMAP=方向光照贴图
option.DIRECTIONAL_LIGHTMAP.comment=为原版光照添加法线贴图效果。§c[-]§r光照贴图可能在此效果启用时出现故障。

option.DIRECTIONAL_LIGHTMAP_STRENGTH=方向光贴图强度
option.DIRECTIONAL_LIGHTMAP_STRENGTH.comment=调整方向光贴图的强度。
value.DIRECTIONAL_LIGHTMAP_STRENGTH.2.0=极低
value.DIRECTIONAL_LIGHTMAP_STRENGTH.1.4=低
value.DIRECTIONAL_LIGHTMAP_STRENGTH.1.0=中
value.DIRECTIONAL_LIGHTMAP_STRENGTH.0.7=高
value.DIRECTIONAL_LIGHTMAP_STRENGTH.0.5=极高

#Atmospherics
option.CLOUDS=云层
option.CLOUDS.comment=启用云层。§a[+]§r真实云层和 Cubulus 云层受益于 TAA。 §e[*]§r原版云层需要将原版云层设置设为默认或开启。
value.CLOUDS.0=§c关闭
value.CLOUDS.1=真实
value.CLOUDS.2=Cubulus
value.CLOUDS.3=原版

option.SKY_DESATURATION=天空脱饱和度
option.SKY_DESATURATION.comment=在夜间降低天空盒的饱和度，并加入一些色调

option.AURORA=极光
option.AURORA.comment=启用极光。§a[+]§r此效果受益于 TAA.

option.AURORA_ONLY_AT_NIGHT=仅在夜间显示极光
option.AURORA_ONLY_AT_NIGHT.comment=如果禁用，则极光将在白天和夜间均可可见。

option.AURORA_PERBIOME=每个群系的极光
option.AURORA_PERBIOME.comment=如果启用，极光将仅在寒冷群系中可见。

option.ROUND_SUN_MOON=圆月与太阳
option.ROUND_SUN_MOON.comment=启用基于着色器的太阳与月亮。§e[*]§r在视频设置 > 细节 > 太阳与月亮中禁用原版太阳与月亮

option.STARS=星星
option.STARS.comment=启用星星。

option.STARS_START=星辰开始
option.STARS_START.comment=决定星辰出现的时刻。
value.STARS_START.0=不开始
value.STARS_START.1=非常早
value.STARS_START.2=早
value.STARS_START.3=默认
value.STARS_START.4=晚
value.STARS_START.5=非常晚

option.STARS_VISIBILITY=星星可见性
option.STARS_VISIBILITY.comment=调整星星的可见性。
value.STARS_VISIBILITY.0.00=星星关闭

option.DISTANT_FADE=远处淡入淡出
option.DISTANT_FADE.comment=淡入淡出远处区块边界。球形模式与原版雾效类似。圆柱形模式忽略 Y 轴。§e[*]§r此选项受雾密度影响。
value.DISTANT_FADE.0=关闭
value.DISTANT_FADE.1=球形
value.DISTANT_FADE.2=圆柱形

option.WEATHER_PERBIOME=按群系的天气
option.WEATHER_PERBIOME.comment=使用不同群系的天气颜色和雾密度。§c[-]§r可能在未知条件下无法正常工作。

option.LIGHT_SHAFT=光线
option.LIGHT_SHAFT.comment=添加来自太阳/月亮的体积光线. §a[+]§r此效果可受益于 TAA. §e[*]§r性能取决于阴影贴图分辨率.

option.LIGHT_SHAFT_STRENGTH=体积光强度
option.LIGHT_SHAFT_STRENGTH.comment=调整体积光强度。

option.LIGHT_SHAFT_STRENGTH_END=末地光束强度
option.LIGHT_SHAFT_STRENGTH_END.comment=调整光束强度。

option.LIGHT_SHAFT_SMOKEY_END=末地烟雾光束
option.LIGHT_SHAFT_SMOKEY_END.comment=在末地添加烟雾光束。

option.LIGHT_SHAFT_SMOKEY_WEATHER=沙尘暴尘雾光束
option.LIGHT_SHAFT_SMOKEY_WEATHER.comment=在沙尘暴期间添加尘雾光束。§e[*]§r此选项需要启用“每个群系天气”选项。

option.FOG_DENSITY=雾密度
option.FOG_DENSITY.comment=调整雾密度。§e[*]§r此选项在地狱中无效。
option.CAVE_FOG_DENSITY=洞穴雾密度
option.CAVE_FOG_DENSITY.comment=调整洞穴雾密度。§e[*]§r雾密度会影响洞穴雾密度。
option.LUSH_CAVES_FOG_DENSITY=茂密洞穴雾密度
option.LUSH_CAVES_FOG_DENSITY.comment=增加茂密洞穴雾密度。§e[*]§r雾密度和洞穴雾密度会影响茂密洞穴雾密度。
option.DRIPSTONE_CAVES_FOG_DENSITY=滴水洞穴雾密度
option.DRIPSTONE_CAVES_FOG_DENSITY.comment=增加滴水洞穴雾密度。§e[*]§r雾密度和洞穴雾密度会影响滴水洞穴雾密度。
option.DEEP_DARK_FOG_DENSITY=深暗雾密度
option.DEEP_DARK_FOG_DENSITY.comment=增加深暗雾密度。§e[*]§r雾密度和洞穴雾密度会影响深暗雾密度。
option.CAVE_FOG_PERBIOME=按生物群系的洞穴雾
option.CAVE_FOG_PERBIOME.comment=为不同的洞穴生物群系使用不同的洞穴雾颜色和密度。

option.WEATHER_OPACITY=天气不透明度
option.WEATHER_OPACITY.comment=调整天气不透明度。

option.ALTITUDE_DENSITY_GRADIENT=高度密度梯度
option.ALTITUDE_DENSITY_GRADIENT.comment=在主世界中应用 y75 到 y320 之间的雾密度梯度。

option.ALTITUDE_DENSITY_GRADIENT_I=梯度强度
option.ALTITUDE_DENSITY_GRADIENT_I.comment=影响“高度密度梯度”选项的梯度强度。

option.GROUND_FOG=地面雾
option.GROUND_FOG.comment=启用地面附近（Y64 高度）的浓雾。如果“动态”地面雾已启用，其密度会在夜间增加，清晨减少，使清晨比傍晚更雾气缭绕。
value.GROUND_FOG.0=关闭
value.GROUND_FOG.1=开启
value.GROUND_FOG.2=动态

option.GROUND_FOG_DENSITY=地面雾密度
option.GROUND_FOG_DENSITY.comment=调整地面雾密度。

option.NETHER_FOG_MODE=下界雾模式
option.NETHER_FOG_MODE.comment=原版：仅生物群系雾，不带密度梯度。高级：生物群系雾 + 熔岩雾，多种密度梯度。
