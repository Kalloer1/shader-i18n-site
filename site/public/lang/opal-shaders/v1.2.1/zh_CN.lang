#Settings
option.ABOUT=OPAL Shaders v1.2.1
option.ABOUT.comment=基于 Capt Tatsu 的 BSL Shaders。bitslablab.com
value.ABOUT.0=by FENVEN

#Lighting
option.shadowMapResolution=阴影贴图质量
option.shadowMapResolution.comment=调整阴影贴图尺寸。[*]更高分辨率能提供更清晰的阴影，但会降低性能。
value.shadowMapResolution.512=极低（512）
value.shadowMapResolution.1024=低（1024）
value.shadowMapResolution.2048=中（2048）
value.shadowMapResolution.3072=高（3072）
value.shadowMapResolution.4096=极高（4096）
value.shadowMapResolution.8192=超高（8192）

option.shadowDistance=阴影距离
option.shadowDIstance.comment=调整阴影距离。

option.SHADOW_CLOUD=云层阴影
option.SHADOW_CLOUD.comment=启用云阴影。

option.SHADOW_COLOR=彩色阴影
option.SHADOW_COLOR.comment=启用半透明物体的染色阴影。§a[+]§r用于彩色体积光。§c[-]§r使用阴影过滤时性能消耗略高。

option.SHADOW_COLOR_CI=半透明阴影颜色强度
option.SHADOW_COLOR_CI.comment=调节染色玻璃和冰的染色阴影颜色强度。
value.SHADOW_COLOR_CI.0=低
value.SHADOW_COLOR_CI.1=中
value.SHADOW_COLOR_CI.2=高
value.SHADOW_COLOR_CI.3=超高

option.SHADOW_COLOR_CI_DT=致密半透明阴影颜色强度
option.SHADOW_COLOR_CI_DT.comment=调节史莱姆块和蜂蜜块的染色阴影颜色强度。
value.SHADOW_COLOR_CI_DT.0=低
value.SHADOW_COLOR_CI_DT.1=中
value.SHADOW_COLOR_CI_DT.2=高

option.SHADOW_COLOR_CI_NP=下界传送门阴影颜色强度
option.SHADOW_COLOR_CI_NP.comment=调节下界传送门的染色阴影颜色强度。
value.SHADOW_COLOR_CI_NP.0=低
value.SHADOW_COLOR_CI_NP.1=中
value.SHADOW_COLOR_CI_NP.2=高

option.WATER_SHADOW_COLOR=水体彩色阴影
option.WATER_SHADOW_COLOR.comment=决定水是否投射用于染色的彩色阴影。§e[*]§r启用后，浸没在水中的透明物将无法投射彩色阴影。

option.WATER_SHADOW_COLOR_CI=水体阴影颜色强度
option.WATER_SHADOW_COLOR_CI.comment=调节水体的染色阴影颜色强度。
value.WATER_SHADOW_COLOR_CI.0=低
value.WATER_SHADOW_COLOR_CI.1=中
value.WATER_SHADOW_COLOR_CI.2=高

option.SHADOW_FILTER=阴影过滤
option.SHADOW_FILTER.comment=启用阴影过滤。§a[+]§r该效果可受益于 TAA。

option.sunPathRotation=太阳路径旋转
option.sunPathRotation.comment=调整太阳角度。

option.SHADOW_SUBSURFACE=次表面散射
option.SHADOW_SUBSURFACE.comment=允许光线穿透植被并散射。

option.SHADOW_PIXEL=像素锁定阴影 
option.SHADOW_PIXEL.comment=对阴影应用像素化效果。
value.SHADOW_PIXEL.0=关

option.WEATHER_SHADOW_SOFTNESS=雨天阴影柔和度
option.WEATHER_SHADOW_SOFTNESS.comment=调节雨天的阴影柔和度。

option.END_SHADOW_SOFTNESS=末地阴影柔和度
option.END_SHADOW_SOFTNESS.comment=调节末地的阴影柔和度。

option.VANILLA_SIDE_SHADING_I=原版侧面着色强度
option.VANILLA_SIDE_SHADING_I.comment=调节方块和实体侧面的原版着色强度。

option.VANILLA_CORNER_SHADING_I=原版边角着色强度
option.VANILLA_CORNER_SHADING_I.comment=调节方块间边角处的原版着色强度。

option.MOON_PHASES=月相
option.FULL_MOON_I_MULTIPLIER=满月亮度
option.GIBBOUS_I_MULTIPLIER=凸月亮度
option.QUARTER_I_MULTIPLIER=弦月亮度
option.CRESCENT_I_MULTIPLIER=峨眉月亮度
option.NEW_MOON_I_MULTIPLIER=新月亮度

option.AO=环境光遮蔽
option.AO.comment=在表面接触或交界处添加柔和阴影。

option.AO_STRENGTH=环境光遮蔽强度
option.AO_STRENGTH.comment=调整环境光遮蔽强度。

option.DESATURATION=去饱和
option.DESATURATION.comment=在较暗区域降低饱和度并添加色调。

option.DESATURATION_FACTOR=最大去饱和度系数
option.DESATURATION_FACTOR.comment=调整应用的最大去饱和度。
value.DESATURATION_FACTOR.2.0=极低
value.DESATURATION_FACTOR.1.5=低
value.DESATURATION_FACTOR.1.0=中
value.DESATURATION_FACTOR.0.5=高
value.DESATURATION_FACTOR.0.0=极高

option.TOON_LIGHTMAP=卡通光照贴图
option.TOON_LIGHTMAP.comment=降低原版光照质量以实现卡通着色。 §e[*]§r此选项会让游戏“看起来很差”，仅在需要时启用。

option.WHITE_WORLD=纯白世界
option.WHITE_WORLD.comment=用纯白色替换纹理。

#Material
option.ADVANCED_MATERIALS=高级材质
option.ADVANCED_MATERIALS.comment=启用高光和法线贴图，可为各种物体增加更多细节。  §e[*]§r此选项需要包含高光和/或法线贴图的资源包，若未使用此类资源包请关闭。

option.MATERIAL_FORMAT=材质格式
option.MATERIAL_FORMAT.comment=决定资源包所使用的高光和法线贴图格式。 §e[*]§r材质作者通常会说明其资源包使用的格式，使用错误的格式可能会导致显示异常。
value.MATERIAL_FORMAT.0=seus pbr
value.MATERIAL_FORMAT.1=labpbr 1.3

option.REFRACTION=折射
option.REFRACTION.comment=启用法线贴图透明表面后方的扭曲效果。[-]透明表面本身会被扭曲。[-]启用此效果时，某些其他功能可能无法正常工作。
value.REFRACTION.0=关
value.REFRACTION.1=仅水体
value.REFRACTION.2=完整

#Reflections
option.REFLECTION=反射
option.REFLECTION.comment=启用屏幕空间反射。 §e[*]§r此开关仅影响水面和半透明反射，雨水和高光反射不受影响。

option.REFLECTION_TRANSLUCENT=半透明反射
option.REFLECTION_TRANSLUCENT.comment=允许在半透明表面上渲染反射，例如彩色玻璃、冰块、黏液块等。

option.REFLECTION_I=反射强度
option.REFLECTION_I.comment=调节反射的强度。

option.REDUCE_SKY_REFLECTIONS_BELOW_SEA_LEVEL=降低海平面以下的天空反射
option.REDUCE_SKY_REFLECTIONS_BELOW_SEA_LEVEL.comment=在海平面（Y62）以下逐渐降低天空反射。

option.REFLECTION_SPECULAR=镜面反射
option.REFLECTION_SPECULAR.comment=在平滑或金属表面上启用反射。

option.REFLECTION_RAIN=雨水反射
option.REFLECTION_RAIN.comment=允许下雨时表面呈现潮湿效果。 §e[*]§r需要高光反射。
value.REFLECTION_RAIN.0=关
value.REFLECTION_RAIN.1=水坑
value.REFLECTION_RAIN.2=完整

option.REFLECTION_ROUGH=粗糙反射
option.REFLECTION_ROUGH.comment=允许光滑度较低的表面渲染模糊反射。 §c[-]§r可能包含轻微瑕疵。

option.REFLECTION_PREVIOUS=前帧反射
option.REFLECTION_PREVIOUS.comment=允许利用上一帧信息反射半透明物体。 §c[-]§r可能会因截图尺寸设置导致截图中反射缺失。 §c[-]§r与部分显卡不兼容。

option.ALBEDO_METAL=反照率着色硬编码金属
option.ALBEDO_METAL.comment=将基础纹理作为色调应用于硬编码的金属表面。[*]仅适用于labpbr材质格式。

#Parallax
option.PARALLAX=视差遮蔽映射
option.PARALLAX.comment=使用高度图在表面添加位移。

option.PARALLAX_DEPTH=视差深度
option.PARALLAX_DEPTH.comment=调节视差深度。
value.PARALLAX_DEPTH.0.05=5厘米
value.PARALLAX_DEPTH.0.10=10厘米
value.PARALLAX_DEPTH.0.15=15厘米
value.PARALLAX_DEPTH.0.20=20厘米
value.PARALLAX_DEPTH.0.25=25厘米
value.PARALLAX_DEPTH.0.30=30厘米
value.PARALLAX_DEPTH.0.35=35厘米
value.PARALLAX_DEPTH.0.40=40厘米
value.PARALLAX_DEPTH.0.45=45厘米
value.PARALLAX_DEPTH.0.50=50厘米

option.SELF_SHADOW=自阴影
option.SELF_SHADOW.comment=允许表面使用高度图向自身投射阴影。

option.SELF_SHADOW_ANGLE=自阴影角度
option.SELF_SHADOW_ANGLE.comment=调节自阴影角度，数值越高阴影延伸越远。

option.PARALLAX_QUALITY=视差质量 
option.PARALLAX_QUALITY.comment=调节视差遮蔽贴图和自身阴影的质量。

option.PARALLAX_DISTANCE=视差距离
option.PARALLAX_DISTANCE.comment=调节视差遮蔽映射与自阴影的最大渲染距离。

option.DIRECTIONAL_LIGHTMAP=定向光照贴图
option.DIRECTIONAL_LIGHTMAP.comment=为原版光照添加法线贴图。 §c[-]§r启用此效果时光照贴图可能会出现异常。

option.DIRECTIONAL_LIGHTMAP_STRENGTH=方向性光照强度
option.DIRECTIONAL_LIGHTMAP_STRENGTH.comment=调整方向光贴图的强度。
value.DIRECTIONAL_LIGHTMAP_STRENGTH.2.0=极低
value.DIRECTIONAL_LIGHTMAP_STRENGTH.1.4=低
value.DIRECTIONAL_LIGHTMAP_STRENGTH.1.0=中
value.DIRECTIONAL_LIGHTMAP_STRENGTH.0.7=高
value.DIRECTIONAL_LIGHTMAP_STRENGTH.0.5=极高

#Atmospherics
option.CLOUDS=云
option.CLOUDS.comment=启用云。 §a[+]§r写实云和积云可受益于 TAA。 §e[*]§r原版云需要将原版云层设置设为默认或开启。
value.CLOUDS.0=§c关闭
value.CLOUDS.1=写实
value.CLOUDS.2=积云
value.CLOUDS.3=原版

option.SKY_DESATURATION=天空去饱和度
option.SKY_DESATURATION.comment=在夜间降低天空盒饱和度并添加色调

option.AURORA=极光
option.AURORA.comment=启用极光。[+]此效果受益于时间性抗锯齿。

option.AURORA_ONLY_AT_NIGHT=仅在夜晚显示极光
option.AURORA_ONLY_AT_NIGHT.comment=若关闭，极光在白天和夜晚均可见。

option.AURORA_PERBIOME=按群系极光
option.AURORA_PERBIOME.comment=若启用，极光将仅在寒冷群系中可见。

option.ROUND_SUN_MOON=圆形日月
option.ROUND_SUN_MOON.comment=启用由光影渲染的日月。 §e[*]§r请在 视频设置 > 细节 > 日月 中关闭原版日月

option.STARS=星星
option.STARS.comment=启用星星。

option.STARS_START=星星出现时机
option.STARS_START.comment=决定星星出现的时刻。
value.STARS_START.0=不出现
value.STARS_START.1=极早
value.STARS_START.2=早
value.STARS_START.3=默认
value.STARS_START.4=晚
value.STARS_START.5=极晚

option.STARS_VISIBILITY=星星可见度
option.STARS_VISIBILITY.comment=调节星星的可见度。
value.STARS_VISIBILITY.0.00=星星关闭

option.DISTANT_FADE=远处渐隐
option.DISTANT_FADE.comment=淡化远处区块边界。球形效果类似原版雾，圆柱形忽略 Y 轴。 §e[*]§r此选项受雾密度影响。
value.DISTANT_FADE.0=关
value.DISTANT_FADE.1=球形
value.DISTANT_FADE.2=圆柱形

option.WEATHER_PERBIOME=按群系天气
option.WEATHER_PERBIOME.comment=为不同群系使用不同的天气颜色和雾密度。 §c[-]§r在未知条件下可能无法正常工作。

option.LIGHT_SHAFT=光线束
option.LIGHT_SHAFT.comment=添加来自日/月的体积光。 §a[+]§r此效果可受益于 TAA。 §e[*]§r性能取决于阴影贴图分辨率。

option.LIGHT_SHAFT_STRENGTH=光轴强度
option.LIGHT_SHAFT_STRENGTH.comment=调节光轴强度。

option.LIGHT_SHAFT_STRENGTH_END=末地体积光强度
option.LIGHT_SHAFT_STRENGTH_END.comment=调节光轴强度。

option.LIGHT_SHAFT_SMOKEY_END=末地烟雾体积光
option.LIGHT_SHAFT_SMOKEY_END.comment=在末地添加烟雾状体积光。

option.LIGHT_SHAFT_SMOKEY_WEATHER=沙尘暴尘雾体积光
option.LIGHT_SHAFT_SMOKEY_WEATHER.comment=在沙尘暴期间添加尘雾状体积光。 §e[*]§r此选项需要启用“按群系天气”选项。

option.FOG_DENSITY=雾密度
option.FOG_DENSITY.comment=调节雾密度。 §e[*]§r此选项在下界中被忽略。
option.CAVE_FOG_DENSITY=洞穴雾气密度
option.CAVE_FOG_DENSITY.comment=调节洞穴雾密度。 §e[*]§r雾密度会影响洞穴雾密度。
option.LUSH_CAVES_FOG_DENSITY=繁茂洞穴雾密度
option.LUSH_CAVES_FOG_DENSITY.comment=额外增加繁茂洞穴的雾密度。 §e[*]§r雾密度和洞穴雾密度会影响繁茂洞穴雾密度。
option.DRIPSTONE_CAVES_FOG_DENSITY=溶洞雾密度
option.DRIPSTONE_CAVES_FOG_DENSITY.comment=额外增加溶洞的雾密度。 §e[*]§r雾密度和洞穴雾密度会影响溶洞雾密度。
option.DEEP_DARK_FOG_DENSITY=深暗之域雾密度
option.DEEP_DARK_FOG_DENSITY.comment=额外增加深暗之域的雾密度。 §e[*]§r雾密度和洞穴雾密度会影响深暗之域雾密度。
option.CAVE_FOG_PERBIOME=按群系洞穴雾
option.CAVE_FOG_PERBIOME.comment=为不同洞穴群系使用不同的洞穴雾颜色和密度。

option.WEATHER_OPACITY=天气不透明度
option.WEATHER_OPACITY.comment=调整天气不透明度。

option.ALTITUDE_DENSITY_GRADIENT=高度密度渐变
option.ALTITUDE_DENSITY_GRADIENT.comment=在主世界 Y75 至 Y320 之间应用雾密度渐变。

option.ALTITUDE_DENSITY_GRADIENT_I=渐变强度
option.ALTITUDE_DENSITY_GRADIENT_I.comment=影响“高度密度渐变”选项的渐变强度。

option.GROUND_FOG=地面雾
option.GROUND_FOG.comment=在地平面（Y64）附近启用浓雾。若启用“动态”地面雾，其密度会在夜间累积并在清晨消散，使清晨比傍晚更多雾。
value.GROUND_FOG.0=关
value.GROUND_FOG.1=开
value.GROUND_FOG.2=动态

option.GROUND_FOG_DENSITY=地面雾密度
