value.WB_DOF_FOCUS.0=自动

option.WB_DB_DAY_I=景深 - 白天
option.WB_DB_NIGHT_I=景深 - 夜晚 & 室内
option.WB_DB_RAIN_I=景深 - 雨天 & 雪天
option.WB_DB_WATER_I=景深 - 水下
option.WB_DB_NETHER_I=景深 - 地下城
option.WB_DB_END_I=景深 - 末地

option.VIGNETTE_R=暗角
option.VIGNETTE_R.comment=在屏幕边缘应用暗化效果。

