# === 构建产物 ===
node_modules/
dist/
site/.vitepress/cache/
site/.vitepress/dist/
.vitepress/cache/
.vitepress/dist/
.wrangler/

# 详情页由 scripts/gen-shader-pages.mjs 在 prebuild 时清空并重建，
# 不入库（否则每次构建产生数百个文件的噪声 diff）。
site/shaders/

# === 密钥与凭证 ===
*.key
*token*
*secret*
.env
.env.*

# === Agent/编辑器工作区 ===
.pi/
.venv/
.claude/
.zcode/
.cursor/
.vscode/
.idea/

# === 源 shader 文件（太大，不入库）===
sources/

# === 本地翻译实验/临时文件 ===
docs/translate-chunks/
docs/missing-en-values.json
docs/translate-progress.json
docs/translate-prompt.txt
site/data/translation-cache.json
run-translate.bat
scripts/push-to-frontend.mjs
scripts/check-update.mjs
scripts/rebuild-clean.py
scripts/gen-site-index.mjs

# === 生成的架构图 ===
project-architecture.html
project-arch.json
architecture.json
pelican-bicycle.svg

# === 其他 ===
*.zip
# 上游 Modrinth 版本号可能自带 .zip 后缀（如 solislite 的 SolisLite_0.1.0_BETA_26.x.zip），
# scripts/pipeline.mjs 用版本号原文做目录名（pipeline.mjs:583），会生成以 .zip 结尾的目录，
# 被 *.zip 误杀。尾斜杠只匹配目录：仅放行 lang 树下的 .zip 结尾目录，真实 .zip 文件仍被忽略。
!site/public/lang/**/
*.bak
*.tmp
todo.json
already-done.json
translate-summary.json

# === Agent 探测残留 ===
.quarkclouddrive/
site/data/version-check-result.limit.json
